+    add(GUI_TEXT,158,146,0,0,0,run_buf);
+    add(GUI_TEXT,(int16_t)(158+(int)run_len*8),146,0,0,0,"_");
+    (void)gfx(GFX_BATCH,(uint32_t)(uintptr_t)list,(uint32_t)n,0);
+}
