     {unsigned k;for(k=0;k<sizeof(dst->title);++k)dst->title[k]=src->title[k];}
@@ -276,6 +277,16 @@
         }
     }
     if(s->damage_count<WM_DAMAGE_MAX)s->damage[s->damage_count++]=r;
+    else{
+        /* Never lose invalidation. Collapse only on overflow; ordinary small
