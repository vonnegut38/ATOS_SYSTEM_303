        /* 3 = gosc zakonczyl sie sam; tos_async_cancel = zadanie uzytkownika
           (Ctrl+Alt+Esc), gdy program TOS nie chce sie zakonczyc. */
        kmem_free(tos_async_stack,KMEM_OWNER_KERNEL);tos_async_stack=0;
        tos_async_state=0u;tos_async_cancel=0u;
        if(kernel_gui_focus_pid()==TOS_ASYNC_PID)kernel_gui_focus_set(0u);
    }
}
