void tos_poll_input(void)
{
    int guard=64;
    if(tos_input_busy)return;
    tos_input_busy=1u;
    tos_poll_mouse_owned(); /* one owner covers BOTH mouse and keyboard */
    while(guard-->0){
        uint32_t type=0u,scan=0u,mods=0u,ch=0u;
        int32_t sc;
        uint8_t s,next;
        int a;
        /* ONE parser owns the IKBD stream: INPUT.SYS.  This loop used to read
           the terminal hook and guess whether a byte was a scancode or an
           already-decoded ASCII character - two contracts in one stream, which
           lost function keys and release events and could change characters.
           kernel_user_keyboard_event() hands over type/scancode/modifiers/ASCII
           already separated, from the same queue the old hook used. */
        if(tos_async_state?tos_async_key_pop(&type,&scan,&mods,&ch):
           kernel_user_keyboard_event(&type,&scan,&mods,&ch)){
            (void)mods;
            sc=(int32_t)(scan&0x7fu);
            if(type==KERNEL_INPUT_KEY_UP){
                s=(uint8_t)(sc|0x80u);
                if(sc==0x2a||sc==0x36)tos_kb_shift=0u;
                else if(sc==0x38)tos_kb_alt=0u;
                tos_key_update(s);
                continue;                 /* a release is never a character */
            }
            s=(uint8_t)sc;
            if(s==0x2a||s==0x36)tos_kb_shift=1u;
            else if(s==0x38)tos_kb_alt=1u;
            else if(s==0x44&&tos_kb_shift&&tos_kb_alt){
                tos_kb_shift=0u;tos_kb_alt=0u;ksessions_hotkey_cycle();}
            tos_key_update(s);
            a=(ch&&ch<0x80u)?(int)ch:0;
            if(!a)a=tos_key_ascii(s,tos_shift,tos_caps);
            if((tos_kbshift&4u)&&a>=0x40&&a<=0x7f)a&=0x1f;
            if(!a&&(s==0x2a||s==0x36||s==0x1d||s==0x38||s==0x3a))continue;
            /* Function/cursor keys have ASCII 0, but their scan code is input. */
        }else{
            /* Fallback for input that only the terminal hook can see (text
               profile console).  The event queue is the same source, so this
               normally finds nothing and the poll ends. */
            if(tos_async_state)break; /* native input belongs to the focused window */
            sc=tos_next_scancode();
            if(sc<0)break;
            if(sc==0x2a||sc==0x36)tos_kb_shift=1u;
            else if(sc==0xaa||sc==0xb6)tos_kb_shift=0u;
            else if(sc==0x38)tos_kb_alt=1u;
            else if(sc==0xb8)tos_kb_alt=0u;
            else if(sc==0x44&&tos_kb_shift&&tos_kb_alt){
                tos_kb_shift=0u;tos_kb_alt=0u;ksessions_hotkey_cycle();}
            tos_key_update((uint8_t)sc);
            a=tos_key_ascii((uint8_t)sc,tos_shift,tos_caps);
            if(!a){
                uint8_t c=(uint8_t)sc;
                if(c>=0x20u||c==0x0du||c==0x08u||c==0x1bu||c==0x09u){a=(int)c;sc=0;}
            }
            if(!a)continue;
            s=(uint8_t)sc;
        }
        next=(uint8_t)((tos_keyq_head+1u)%TOS_KEYQ);
        if(next==tos_keyq_tail)break;                 /* queue full: drop */
        tos_keyq[tos_keyq_head]=(sc<<16)|a;
        tos_keyq_mods[tos_keyq_head]=tos_kbshift;
        tos_keyq_head=next;
    }
    tos_input_busy=0u;
}
static int32_t tos_keyq_pop(void)
{
    int32_t k;
    if(tos_keyq_tail==tos_keyq_head)return -1;
    k=tos_keyq[tos_keyq_tail];
    tos_key_lastmods=tos_keyq_mods[tos_keyq_tail];
    tos_keyq_tail=(uint8_t)((tos_keyq_tail+1u)%TOS_KEYQ);
    tos_last_scancode=(uint8_t)(k>>16);
    return k;
}
/* GEMDOS Cconin blocks until a key arrives.  A bounded loop used to return a
 * fake Enter after a couple of seconds, which silently ended programs that
 * were waiting for input (and closed their desktop window).  Timer C keeps
 * running while we wait, so the compositor and the clock stay alive. */
static int32_t tos_getkey(void)
{
    if(tos_key_pending>=0){int32_t k=tos_key_pending;tos_key_pending=-2;return k;}
    if(!tos_input_pop)return 0x0d;
    for(;;){
        int32_t k=tos_keyq_pop();
        if(k>=0)return k;
        tos_poll_input();
        /* A blocking key read must service the same deferred presentation as
           evnt_multi. Timer C only wakes this worker; it never renders. */
        tos_mark_present();
        tos_composite_work();
        if(tos_exit_pending()){tos_exit_code=0;asf_tos_exit();return 0;}
    }
}
static int32_t tos_key_ready(void)
{
    if(tos_key_pending>=0)return 1;
    if(tos_keyq_head!=tos_keyq_tail){tos_key_pending=tos_keyq_pop();return 1;}
    return 0;
}

