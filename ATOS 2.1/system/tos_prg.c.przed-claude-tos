static int tos_open_window(const char *name)
{
    if(!tos_window_enabled)return 0;     /* T2 opcode 8: classic console */
    if(!vid_enter||!vid_fill||!vid_text)return 0;
    tos_update_window_geometry();
    tos_win_x=((int32_t)kvideo_mode_width()-(int32_t)tos_win_w)/2;
    tos_win_y=((int32_t)kvideo_mode_height()-(int32_t)tos_win_h-(int32_t)TOS_TITLE)/2;
    if(tos_win_x<8)tos_win_x=8;
    if(tos_win_y<8)tos_win_y=8;
    ++tos_window_seq;
    vid_enter();
    tos_desktop_active=1u;
    tos_apply_palette();
    /* D2: register the TOS window in the WM with a client surface; the WM
       draws the frame and composes the client (occlusion).  Fall back to the
       direct overlay only when the WM cannot provide a surface. */
    {
        uint32_t wpid=tos_async_state?TOS_ASYNC_PID:kernel_user_current_pid();
        uint16_t wh=(uint16_t)(TOS_WM_HANDLE_BASE+(uint16_t)tos_window_seq);
        tos_wm_pid=wpid;tos_wm_handle=wh;
        kernel_wm_set_window(wpid,wh,(int16_t)tos_win_x,(int16_t)tos_win_y,
                             (uint16_t)tos_win_w,(uint16_t)(tos_win_h+TOS_TITLE));
        /* Name the window after the program: without this the WM chrome said
           "APPLICATION" for every TOS program. */
        kernel_wm_set_title(wpid,wh,name);
        if(tos_async_state)kernel_gui_focus_set(TOS_ASYNC_PID);
        tos_client_surface=kernel_wm_app_surface(wpid,wh);
        tos_surface_installed=tos_client_surface?1u:0u;
        /* A GEM program waits for WM_REDRAW right after opening its window and
           blocks in evnt_mesag until it arrives; that message is what makes it
           draw.  Post it once here, from the same place the window appears. */
        tos_msg_redraw();
    }
    /* VDI must follow the window: see tos_vdi_follow_screen(). */
    tos_vdi_follow_screen();
    if(tos_client_surface){
        kgfx_planar_surface_override=tos_client_surface;
        kgfx_planar_surface_pitch=kvideo_mode_width();
    }else{
        kgfx_planar_surface_override=0;
        tos_draw_window_chrome(name);
    }
    tos_window_active=1u;
    if(!tos_shadow)tos_shadow=(uint8_t *)kmem_alloc(TOS_SHADOW_BYTES,4u,KMEM_OWNER_KERNEL,KMEM_READ|KMEM_WRITE,1);
    tos_wm_input_pending=0u;tos_force_present=0u;
    tos_last_cursor_tick=tos_now_ticks();
    tos_composite_now();
    return 1;
}

/* The BIOS console and the 8bpp desktop share the ET4000 memory, so after
 * switching back to the text mode the card holds the desktop's pixels. The
 * console must be cleared before anything is printed again. */
int32_t kernel_tos_desktop_active(void){return tos_desktop_active?1:0;}

static void tos_desktop_leave(void)
{
    if(vid_leave)vid_leave();
    if(console_clear_hook)console_clear_hook();   /* resets the console cursor */
    if(vid_clear)vid_clear(0u);                   /* wipe the whole card memory */
    /* Give the desktop its own colours back: the program's palette block shares
       the RAMDAC range with the theme ramp, and mono runs pin entries 0/15. */
    (void)kgfx_theme_apply(kgfx_theme_current());
    tos_desktop_active=0u;
}

static void tos_close_window(void)
{
    if(!tos_window_active)return;
    tos_window_active=0u;
    if(tos_shadow){kmem_free(tos_shadow,KMEM_OWNER_KERNEL);tos_shadow=0;}
    tos_shadow_source=0;tos_band_valid=0u;
    kgfx_planar_surface_override=0;   /* D2: stop redirecting into the client surface */
    tos_client_surface=0;
    tos_surface_installed=0u;         /* a later "no surface" is not a loss */
    tos_vdi_release_screen();         /* VDI back to the profile's target */
    /* D2: release the WM window + backing surface so repeated runs do not
       leak slots (the window may never have been registered if the desktop was
       inactive at open time). */
    if(tos_wm_pid)kernel_wm_release_surface(tos_wm_pid,tos_wm_handle);
    tos_wm_pid=0;tos_wm_handle=0;
    /* While the window mode is on the desktop stays: only the application
       window disappears.  Leaving the graphics mode here was why the shell
       "came back" after every program. */
    /* The window was an overlay; the launching app repaints the desktop when
       gui_call(65) returns, so nothing has to be redrawn here. */
    if(tos_window_enabled){
        /* ...but the RAMDAC does: the client palette block shares its range with
           the theme ramp, so reapply the desktop theme before handover. */
        (void)kgfx_theme_apply(kgfx_theme_current());
        return;
    }
    tos_desktop_leave();
}
/* ---- TOS TPA -------------------------------------------------------------
   The kernel lives in ST-RAM just above the program area, so the TPA is the
   contiguous free region [0x1000, __image_start).  A program is allocated
   first-fit from the bottom (exactly what EmuTOS alloc_tpa does) and released
   LIFO when the run returns; the kernel heap (kmem) sits above the image. */
extern uint8_t __image_start;
/* The kernel occupies the low ST-RAM, so a TOS program only had a ~520 kB TPA
   ([0x1000, __image_start)).  Real TOS hands out nearly all of RAM; the
   HWAM/PFX self-extractors size their decompression buffer from p_hitpa and
   _memtop, and under-sized geometry makes them unpack only part of the inner
   program (Session 9).  The TF536 has 64 MB TT-RAM; reserve its top 16 MB for
   the TOS TPA for p_hitpa. ST sysvars remain separate from this TT-RAM program area. */
#define TOS_TPA_BASE 0x04000000UL
#define TOS_TPA_TOP  0x05000000UL
static uint32_t tos_tpa_next=TOS_TPA_BASE;
static uint32_t tos_tpa_top(void){return TOS_TPA_TOP;}
static void *tos_tpa_alloc(uint32_t bytes)
{
    uint32_t top=tos_tpa_top(),p=(tos_tpa_next+15u)&~15u;
    if(bytes==0u||p<TOS_TPA_BASE||p>top||bytes>top-p)return 0;
    tos_tpa_next=p+bytes;
    return (void *)(uintptr_t)p;
}
/* Sysvars are only 2-byte aligned, so publish them with word stores (68000). */
