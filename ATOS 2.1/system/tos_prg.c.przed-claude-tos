extern volatile uint32_t kernel_fault_pc;
void asf_tos_fault(uint32_t vector)
{
    uint32_t pc;
    ++kdbg_tos_faults;                 /* direct evidence for the harness */
    tos_print("TOS FAULT vec=");tos_dec(vector&0xffffu);
    /* The stub records the PC from hardware-frame offset +2. */
    pc=kernel_fault_pc;
    kernel_linef_pc=pc;
    kernel_linef_op=(pc>=0x00040000u&&pc<0x00c00000u)?
        (uint32_t)*(const uint16_t *)(uintptr_t)pc:0u;
    /* Keep arithmetic faults fatal; a visible window is not proof of success. */
    if((vector&0xffffu)==5u){
        /* A divide-by-zero is an ERROR, not something to paper over: resuming
           with the stale destination register made "rc = 0" look like success.
           It is counted, reported, and the run ends with a distinct code; a
           program that wants to survive installs its own vector 5 handler
           (honouring guest vectors is a separate, documented gap). */
        ++kdbg_tos_divzero;
        tos_print("TOS DIV BY ZERO pc=");tos_dec(pc&0xffffffffu);
        tos_print(" d0=");tos_dec(kernel_fault_d0);
        tos_print("\n");
        tos_exit_code=-5;
        asf_tos_exit();
        for(;;){}
    }
    tos_exit_code=-(int32_t)(vector&0xffffu);
    asf_tos_exit();
    for(;;){}
}

