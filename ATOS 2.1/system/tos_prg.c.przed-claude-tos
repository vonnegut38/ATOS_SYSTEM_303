        hnd[3]=(uint32_t)(uintptr_t)asf_tos_fault5;
        hnd[4]=(uint32_t)(uintptr_t)asf_tos_fault6;
        hnd[5]=(uint32_t)(uintptr_t)asf_tos_fault7;
        hnd[6]=(uint32_t)(uintptr_t)asf_tos_fault8;
        hnd[7]=(uint32_t)(uintptr_t)asf_tos_linea;
        hnd[8]=(uint32_t)(uintptr_t)asf_tos_fault11;
        hnd[9]=(uint32_t)(uintptr_t)asf_tos_trap1;
        hnd[10]=(uint32_t)(uintptr_t)asf_tos_trap2;
        hnd[11]=(uint32_t)(uintptr_t)asf_tos_trap13;
        hnd[12]=(uint32_t)(uintptr_t)asf_tos_trap14;
        for(k=0u;k<13u;++k)tos_saved_vec[k]=vec[vidx[k]];
        tos_vec_snapshot_save();
        for(k=0u;k<13u;++k)vec[vidx[k]]=hnd[k];
        entry=text;
        /* Register the run as a task slot.  G1.3b hands the slot to the
           scheduler instead of running it inline. */
        slot=tos_task_alloc();
        if(slot>=0){
            tos_task_current=(uint8_t)slot;
            tos_task[slot].used=1u;
            tos_task[slot].sp=0u;
            tos_task[slot].basepage=mem;
            tos_task[slot].entry=(uint8_t *)entry;
            tos_task[slot].pid=0u;
            tos_task[slot].state=0;
            tos_task[slot].mem=0;
            tos_task[slot].stack=0;
            tos_task[slot].total=0u;
        }
        tos_keyq_head=tos_keyq_tail=0u;
        {unsigned z=0;tos_cur_path[0]='\\';tos_cur_path[1]=0;for(z=0;z<TOS_DIR_MAX;++z)tos_dir[z].name[0]=0;}
        tos_dir_count=tos_dir_index=0;tos_dir_attr=0xffffu;
        tos_shift=tos_caps=tos_kbshift=0u;
        /* A previous run can have ended INSIDE an event wait, because those
           call asf_tos_exit() from within tos_poll_input()'s caller and never
           return to clear the guard.  Left at 1 it made every later program
           ignore the mouse and the keyboard - the reported "first run fine,
           relaunch hangs".  Reset it, and the pointer buttons with it. */
        tos_input_busy=0u;
        tos_mouse_buttons=0u;
        tos_con_reset();
        aes_windows=0u;aes_wg_first=0u;tos_redraw_sent=0u;
        tos_msgq_head=tos_msgq_tail=0u;      /* fresh message queue per run */
        tos_key_pending=-2;tos_exit_request=0u;
        tos_active=1u;
        kernel_tos_runtime_enabled=1u;
        tos_rawlog_n=0u;tos_rawlog_i=0u;
        tos_open_window(tos_basename(path));
        /* Task 3: keep the load geometry readable from normal context even
           after the program closes. */
        kernel_tos_dbg_basepage=(uint32_t)(uintptr_t)mem;
        kernel_tos_dbg_entry=(uint32_t)(uintptr_t)entry;
        kernel_tos_dbg_total=total;
        /* GEMDOS/TOS: at program entry the basepage is at 4(sp) (EmuTOS
           proc_go sets it up that way).  Packers such as HWAM-SOFT read it
           from the stack, so carry it even though asf_tos_enter also passes
           the basepage in a0. */
        /* EmuTOS proc_go/gouser: SP = p_hitpa - sizeof(gouser_stack); at entry
           0(sp) is a dummy and 4(sp) is the basepage (bdos/proc.c:528-567), and
           a0 = 0 marks a normal program.  Packers read the basepage from the
           stack; PFX decompresses downward from p_hitpa. */
        {uint8_t *usp=(uint8_t *)(uintptr_t)(((uintptr_t)(mem+total-58u))&~1u);
         uint32_t z;for(z=0u;z<54u;z+=4u)wr32(usp+z,0u);
         wr32(usp+0,0u);
         wr32(usp+4,(uint32_t)(uintptr_t)mem);
         asf_tos_enter(mem,entry,usp);}   /* a3=basepage; a0=0 set inside */
        tos_active=0u;
        kernel_tos_runtime_enabled=0u;
        /* One final composite of the program's last frame, in kernel context
           (not the interrupt), before the window closes.  Force it past the
           deadline so the last frame is never dropped. */
        tos_composite_pending=1u;
        tos_force_present=1u;
        tos_composite_work();
        tos_close_window();
        tos_task_free(slot);
        for(k=0u;k<13u;++k)vec[vidx[k]]=tos_saved_vec[k];
        tos_vec_snapshot_restore();   /* nothing may point into freed TPA */
        /* Audio belongs in the same category as the vectors: the Dosound table
           lives in the program's TPA, so the interpreter must be detached and the
           domain owner released BEFORE that memory goes back to the allocator. */
        (void)kaudio_tos_teardown();
        kaudio_set_port_sink(0);
    }
    kmem_free(file,KMEM_OWNER_KERNEL);
    if(env_block)kmem_free(env_block,KMEM_OWNER_KERNEL);   /* was leaked per run */
    if(tos_screen&&tos_screen_owned)kmem_free(tos_screen,KMEM_OWNER_KERNEL);
    tos_alloc_cleanup(mem);
    tos_current_basepage=0;tos_process_limit=0;
    tos_screen=0;tos_heap=0;
    tos_window_enabled=0u;                    /* one run, one decision */
    tos_tpa_next=tpa_mark;                    /* release the program block (LIFO) */
    kblock_cache_clear();
    /* Only report the cache when it is actually enabled: an unconditional
       "DISK CACHE: OFF ..." after every program was pure noise. */
    tos_print("TOS TASKS LEFT: ");tos_dec((uint32_t)tos_task_count());tos_print("\n");
    if(tos_last_scancode){
        tos_print("TOS EXIT KEY: scancode 0x");
        {const char *hx="0123456789ABCDEF";tos_putc(hx[(tos_last_scancode>>4)&15u]);tos_putc(hx[tos_last_scancode&15u]);}
        tos_print("  raw(16):");
        {const char *hx2="0123456789ABCDEF";uint8_t k;
         for(k=0u;k<tos_rawlog_n;++k){
            uint8_t b=tos_rawlog[(uint8_t)((tos_rawlog_i+16u-tos_rawlog_n+k)&15u)];
            tos_putc(' ');tos_putc(hx2[(b>>4)&15u]);tos_putc(hx2[b&15u]);
        }}
        tos_print("\n");
        tos_last_scancode=0u;tos_rawlog_n=0u;tos_rawlog_i=0u;
    }
    if(kblock_cache_sectors()){
        {kblock_stats_t st;kblock_cache_stats(&st);
         tos_print("DISK CACHE: ");tos_dec(kblock_cache_sectors());tos_print(" sectors, hits=");
         tos_dec(st.hits);tos_print(" misses=");tos_dec(st.misses);
         tos_print(" writebacks=");tos_dec(st.writes);tos_print("\n");}
    }
    rc=tos_exit_code;
    if(rc<0)tos_print("TOS PROGRAM FAULT\n");
    return rc;
}

/* --- link restores (definitions only) --- */
volatile uint32_t kernel_wall_ticks = 0u;
uint32_t kernel_linef_pc = 0u, kernel_linef_op = 0u, kernel_linef_frame[6] = {0,0,0,0,0,0};

static void tos_async_low_copy(uint32_t *dst,const uint32_t *src)
/* Addresses 0..7 are reset vectors, write-protected by Atari hardware. */
{unsigned i;for(i=2u;i<512u;++i)((volatile uint32_t *)dst)[i]=((const volatile uint32_t *)src)[i];}
static uint16_t tos_async_lock(void)
{uint16_t sr;__asm__ volatile("move.w %%sr,%0\n\tori.w #0x0700,%%sr":"=d"(sr)::"memory");return sr;}
static void tos_async_unlock(uint16_t sr)
{__asm__ volatile("move.w %0,%%sr"::"d"(sr):"memory");}
static void tos_async_park(void)
{
    uint16_t sr=tos_async_lock();
    if(tos_cpu_type)tos_async_guest_vbr=tos_async_read_vbr();
    if(tos_cpu_type>=2u&&tos_cpu_type<=3u)tos_async_guest_cacr=tos_async_read_cacr();
    tos_async_low_copy(tos_async_guest_low,(const uint32_t *)0);
    tos_async_low_copy((uint32_t *)0,tos_async_native_low);
    tos_async_target=kgfx_planar_surface_override;
    tos_async_pitch=kgfx_planar_surface_pitch;
    kgfx_planar_surface_override=0;kgfx_planar_surface_pitch=0;
    kernel_tos_runtime_enabled=0u;tos_async_in_guest=0u;
    if(tos_cpu_type)asf_tos_set_vbr(tos_async_native_vbr);
    if(tos_cpu_type>=2u&&tos_cpu_type<=3u)tos_async_write_cacr(tos_async_native_cacr|8u);
    tos_async_switch(&tos_async_guest_sp,tos_async_native_sp);
    tos_async_unlock(sr);
}
static void tos_async_yield(void)
{
    uint16_t sr;
    if(tos_async_state!=2u||!tos_async_in_guest||tos_input_busy)return;
    __asm__ volatile("move.w %%sr,%0":"=d"(sr));
    if((sr&0x0700u)>0x0500u)return; /* never suspend an interrupt callback */
    if((uint32_t)(kernel_user_hires_clock()-tos_async_slice)<246u)return;
    if(!kernel_tos_async_yields)__asm__ volatile("move.l %%sp,%0":"=m"(kernel_tos_async_first_sp));
    ++kernel_tos_async_yields;
    tos_async_park();
}
static void tos_async_entry(void)
{
    tos_async_unlock(0x2500u);
    kernel_tos_async_result=kernel_tos_run_program(tos_async_path);
    tos_async_state=3u;
    tos_async_park();
    for(;;){} /* completion is collected by the supervisor, never resumed */
}
int32_t kernel_tos_start_async(const char *path)
{
    unsigned i;uint32_t size=0u;uint8_t attr=0;
    if(tos_async_state||tos_active)return -0x2b1;
    if(tos_cpu_type>3u)return -0x2ff; /* cache/FPU context for 040+ is not implemented */
    if(!path||!*path)return -1;
    for(i=0;i<63u&&path[i];++i)tos_async_path[i]=path[i];
    if(path[i])return -0x2b0;
    tos_async_path[i]=0;
    if(kfat_stat_path(path,&size,&attr)!=FAT_FILE_FOUND||size<28u)return -2;
    tos_async_stack=(uint8_t *)kmem_alloc(32768u,16u,KMEM_OWNER_KERNEL,KMEM_READ|KMEM_WRITE,1);
    if(!tos_async_stack)return -3;
    /* switch restores USP + eleven callee-saved registers + return PC. */
    tos_async_guest_sp=tos_async_stack+32768u-52u;
    for(i=0;i<52u;++i)((uint8_t *)tos_async_guest_sp)[i]=0;
    ((uint32_t *)tos_async_guest_sp)[12]=(uint32_t)(uintptr_t)tos_async_entry;
    tos_async_key_head=tos_async_key_tail=tos_async_mouse_head=tos_async_mouse_tail=0;
    tos_async_mouse_x=ksessions_mouse_x();tos_async_mouse_y=ksessions_mouse_y();
