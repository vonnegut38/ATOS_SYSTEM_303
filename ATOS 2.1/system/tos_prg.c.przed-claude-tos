/* Full user-vector snapshot for the run.  A program that installs a handler
   via Setexc (or a direct write) must not leave it pointing into memory that
   is freed when the program exits - that was the "JSR under 0" class of
   failure.  Range: vectors 2..47 (0x08..0xBC) and 0x60..0x7F (0x180..0x1FC). */
#define TOS_VEC_LO  2u
#define TOS_VEC_HI  47u
#define TOS_VEC2_LO 0x60u
#define TOS_VEC2_HI 0x7Fu
#define TOS_VEC_SNAP ((TOS_VEC_HI-TOS_VEC_LO+1u)+(TOS_VEC2_HI-TOS_VEC2_LO+1u))
static uint32_t tos_vec_snap[TOS_VEC_SNAP];
/* A valid default: the CPU takes these vectors, so a plain RTE returns safely
   if the program chains to what Setexc reported as "the old handler". */
extern void asf_tos_just_rte(void);
static uint32_t *tos_vec_slot(uint32_t v)
{
    if(v>=TOS_VEC_LO&&v<=TOS_VEC_HI)return &((uint32_t *)(uintptr_t)0)[v];
    if(v>=TOS_VEC2_LO&&v<=TOS_VEC2_HI)return &((uint32_t *)(uintptr_t)0)[v];
    if(v>=0x100u&&v<0x140u)return &((uint32_t *)(uintptr_t)0)[v];  /* etv_* vars */
    return 0;
}
static void tos_vec_snapshot_save(void)
{
    uint32_t i,v;
    for(i=0u,v=TOS_VEC_LO;v<=TOS_VEC_HI;++v,++i)tos_vec_snap[i]=*(uint32_t *)(uintptr_t)(4u*v);
    for(v=TOS_VEC2_LO;v<=TOS_VEC2_HI;++v,++i)tos_vec_snap[i]=*(uint32_t *)(uintptr_t)(4u*v);
}
static void tos_vec_snapshot_restore(void)
{
    uint32_t i,v;
    for(i=0u,v=TOS_VEC_LO;v<=TOS_VEC_HI;++v,++i)*(uint32_t *)(uintptr_t)(4u*v)=tos_vec_snap[i];
    for(v=TOS_VEC2_LO;v<=TOS_VEC2_HI;++v,++i)*(uint32_t *)(uintptr_t)(4u*v)=tos_vec_snap[i];
}
