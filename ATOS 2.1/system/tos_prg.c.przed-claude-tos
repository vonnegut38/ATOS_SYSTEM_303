/* Diagnostics: what the TOS framing actually sees.  kdbg_real_mouse counts the
   packets that reached the DESKTOP pump; these count the packets captured by
   the TOS framing, which is the only path that runs while a program owns the
   screen.  kdbg_real_dxdy-style packed last deltas make a framing mistake
   visible instead of guessable. */
uint32_t kdbg_tos_mouse_packets,kdbg_tos_mouse_dxdy;
uint32_t kdbg_evbtn_n,kdbg_evmouse_n;   /* evnt_button/evnt_mouse served */
static void tos_rawlog_add(uint8_t b)
{
    tos_rawlog[tos_rawlog_i]=b;
    tos_rawlog_i=(uint8_t)((tos_rawlog_i+1u)&15u);
    if(tos_rawlog_n<16u)++tos_rawlog_n;
}
static int32_t tos_next_scancode(void)
{
    uint8_t *skip=&tos_mouse_skip;
    if(!tos_input_pop)return -1;
    for(;;){
        int32_t v=tos_input_pop();
        uint8_t sc;
        if(v<0)return -1;
        sc=(uint8_t)v;
        tos_rawlog_add(sc);
        /* NOTE: an OVRN-based resync ("discard until the next 0xF8-0xFF
           header") was tried here and had to be removed: the emulated ACIA
           keeps bit 5 set often, so it discarded ordinary key scancodes until
           none were left (typing lost/merged commands). */
        (void)tos_resync;
        /* RAW IKBD PARSING BELONGS TO INPUT.SYS.  This branch used to look for
           a mouse header and treat the next two bytes as deltas, but the hook
           behind it (kernel_user_terminal_getchar) only ever returns keyboard
           characters - INPUT.SYS delivers mouse packets to its own queue - so
           it could never see a real mouse.  The bytes are consumed here only
           because this fallback path shares the stream. */
        if(*skip){--*skip;continue;}
        /* A relative mouse packet is header + X + Y.  Hatari (and real
           IKBDs in "both mouse and joystick" mode) emit headers across the
           whole 0xF8-0xFF range - 0xFE in particular.  Treating 0xFE as a
           lone status byte shifted the frame by one and leaked a coordinate
           (raw: F8 D0 F8 FE FB F8 F8 00 1C). */
        if(sc>=0xf8u){*skip=2u;continue;}
        if(sc>=0xf0u)continue;
        return (int32_t)sc;
    }
}

