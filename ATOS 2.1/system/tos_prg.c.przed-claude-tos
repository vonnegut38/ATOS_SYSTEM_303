        if(mode==0u){                                                   /* load + execute */
            if(tos_state_depth>=4)return -1;
            if(cmdline)kernel_user_set_arguments((const char *)(uintptr_t)cmdline);
            tos_state_save(&tos_states[tos_state_depth]);
            tos_state_depth++;
            r=kernel_tos_run_program((const char *)(uintptr_t)prog);
            tos_state_depth--;
            tos_state_restore(&tos_states[tos_state_depth]);
            return r;
        }
        /* mode 3 (load only -> basepage), 4/5 (basepage create), 6/7 (env):
           not implemented yet. */
        return -32;                                                     /* EINVFN */
    }
    case 0x4cu: tos_dbg_exit_fn=0x4cu;
               tos_dbg_exit_pc=tos_ptr_plausible((uint32_t)(uintptr_t)frame)?rd32((const uint8_t *)frame+2u):0u;
               /* Pterm takes its code from the stack word, not from a[]: read it
                  only when the stack pointer is usable. */
               /* the stack holds the FUNCTION word first, then the code
                  (tos_args() == usp+2), so reading usp reported 76 = 0x4C:
                  Pterm(5) returned "76". */
               tos_exit_code=tos_ptr_plausible(usp)?(int32_t)rd16((const uint8_t *)usp+2u):0;
               asf_tos_exit();return 0; /* Pterm */
    case 0x4eu: {uint32_t p=((uint32_t)a[0]<<16)|a[1];                      /* Fsfirst(path,attr) */
                 return tos_fsfirst((const char *)(uintptr_t)p,(uint16_t)a[2]);}
    case 0x4fu: return tos_fsnext();                                     /* Fsnext */
    case 0x56u: {uint32_t f=rd32((const uint8_t *)a+2u);               /* Frename: reserved WORD first */
        uint32_t t=rd32((const uint8_t *)a+6u);
        if(!f||!t)return -33;
        return kfat_rename_path((const char *)(uintptr_t)f,(const char *)(uintptr_t)t)==FAT_FILE_FOUND?0:-33;}
    default: tos_note_unsupported_at(1u,fn,-32,(const int16_t *)a,4);
             return -32;                                                /* EINVFN: unsupported */
    }
}

/* --- TOS BIOS (trap #13) --------------------------------------------------- */
uint32_t tos_bios_opcount[256];
int32_t asf_tos_bios(uint32_t fn,uint32_t *frame,uint32_t usp)
{
    tos_mark_present();
    /* Window closed from its chrome while the program runs: unwind like
       Pterm0 at the next OS call. */
    if(tos_exit_pending()){tos_exit_capture(usp);tos_exit_code=0;asf_tos_exit();return 0;}
    uint16_t *a=tos_args(frame,usp);
    fn&=0xffffu;
    if(frame)tos_last_caller_pc=rd32((const uint8_t *)frame+2u);
    ++tos_bios_opcount[fn&255u];
    if(fn==1u)return tos_key_ready();         /* Bconstat */
    if(fn==2u)return tos_getkey();            /* Bconin */
    if(fn==3u){if(a[0]==2u||a[0]==5u)tos_console_byte((uint8_t)a[1]);return 0;}  /* Bconout(dev,c) */
    if(fn==7u)return a[0]==2u&&kfat_tos_bpb(tos_bpb)?(int32_t)(uintptr_t)tos_bpb:0;
    if(fn==5u){                                                       /* Setexc(vec,handler) */
        /* TOS contract: return the OLD vector and install the new one when the
           handler is not -1.  Returning 0 for everything made programs store a
           NULL "previous handler" and later jump to address 0.  For vectors the
           kernel does not provide itself we report a real RTE stub instead. */
        uint32_t v=((uint32_t)(uint16_t)a[0]);
        int32_t newh=((int32_t)(uint16_t)a[1]<<16)|(uint16_t)a[2];
        uint32_t *slot=tos_vec_slot(v);
        uint32_t old=(uint32_t)(uintptr_t)asf_tos_just_rte;
        if(!slot)return -1;                       /* unknown vector: report failure */
        old=*slot;
        if(newh!=-1){                             /* -1 = query only */
            if(!old)old=(uint32_t)(uintptr_t)asf_tos_just_rte;
            *slot=(uint32_t)newh;
        }
        return (int32_t)old;
    }
    if(fn==10u)return (int32_t)tos_drivemap();
    if(fn==8u)return (a[0]==2u||a[0]==5u)?-1:0;                       /* Bcostat */
    if(fn==11u){uint8_t old=tos_kbshift;if((int16_t)a[0]>=0)tos_kbshift=(uint8_t)a[0];return old;}                      /* Kbshift */
    tos_note_unsupported_at(2u,fn,0,(const int16_t *)a,4);   /* BIOS: not implemented */
    return 0;
}

/* --- TOS XBIOS (trap #14) -------------------------------------------------- */
/* XBIOS opcode histogram: shows how SysInfo asks about the screen. */
uint32_t tos_xbios_opcount[256];
uint32_t kdbg_tos_xbios34,kdbg_tos_xbios14;   /* XBIOS 34/14 call counters */
/* Audio XBIOS (28 Giaccess, 29 Offgibit, 30 Ongibit, 31 Xbtimer, 32 Dosound).
   These were "return 0", i.e. a fake success; the plan for the audio subsystem
   requires real contracts, so they are counted and reported separately. */
uint32_t kdbg_tos_xbios28r,kdbg_tos_xbios28w,kdbg_tos_xbios29,kdbg_tos_xbios30,
         kdbg_tos_xbios31,kdbg_tos_xbios32;
/* Virtual PSG ports for TOS windows.  Port A carries the floppy drive/side
   select, the printer strobe and the RS232 control lines: those belong to their
   drivers, not to a guest running in supervisor mode, so a window sees its own
   port state.  Writes are counted (kdbg_tos_vport_w) because the legacy XBIOS
   return value has no room for "virtualised". */
uint8_t tos_vport_a=0x07u;      /* both drives deselected, side 0 - the ST default */
uint8_t tos_vport_b=0xffu;      /* port B is an input on an ST */
uint32_t kdbg_tos_vport_w,kdbg_tos_audio_refused;

static uint8_t tos_vport_read(uint32_t idx){return idx==14u?tos_vport_a:tos_vport_b;}

/* Owner rule from the audio plan: a TOS window may write sound registers only
   while no native application owns the chip.  A refusal is reported through the
   counters, never by inventing a different meaning for the legacy result. */
/* The Dosound interpreter writes registers from the interrupt.  Ports 14/15
   must land in the same virtual state Giaccess uses, never on the real chip
   (audit P1.2): the core calls this for every register >= 14. */
static int tos_port_sink(uint8_t reg,uint8_t value)
{
    if(reg==14u)tos_vport_a=value;else tos_vport_b=value;
    ++kdbg_tos_vport_w;
    return 1;                                  /* handled virtually */
}

/* Where does a sound table live?  TOS accepts a table in the base TPA or in a
   block allocated with Malloc, so both are allowed - and the interpreter is
   given the END of that region, because a valid first byte says nothing about
   the bytes the interrupt will read next (audit P1.3).  Returns 0 when the
   pointer is not in a buffer we know about. */
static const uint8_t *tos_table_end(const uint8_t *table)
{
    uintptr_t p=(uintptr_t)table;
    uintptr_t base=(uintptr_t)tos_current_basepage;
    uintptr_t end=(uintptr_t)tos_process_limit;    /* this is an ADDRESS, not a size */
    unsigned i;
    if(base&&end>base&&p>=base&&p<end)return (const uint8_t *)end;
    /* Every slot, holes included: freeing the first allocation used to leave a
       hole that stopped this search, so a valid table in a later block was
       rejected (audit point 2). */
    for(i=0u;i<TOS_ALLOC_SLOTS;++i){
        uintptr_t a,size;
        if(!tos_allocs[i].ptr)continue;                     /* hole: skip it */
        if(tos_allocs[i].process!=tos_current_basepage)continue;
        a=(uintptr_t)tos_allocs[i].ptr;
        size=(uintptr_t)tos_allocs[i].size;
        if(!size||a+size<a)continue;                        /* overflow guard */
        if(p>=a&&p<a+size)return (const uint8_t *)(a+size);
    }
    return 0;
}

static void tos_apply_palette(void);          /* defined with the T2 window */
/* Set by Setscreen/Setrez when a running window has to adopt a new mode. */
static uint8_t tos_desktop_pending;
int32_t asf_tos_xbios(uint32_t fn,uint32_t *frame,uint32_t usp)
{
    tos_mark_present();
    /* Window closed from its chrome while the program runs: unwind like
       Pterm0 at the next OS call. */
    if(tos_exit_pending()){tos_exit_capture(usp);tos_exit_code=0;asf_tos_exit();return 0;}
    uint16_t *a=tos_args(frame,usp);
    fn&=0xffffu;
    if(frame)tos_last_caller_pc=rd32((const uint8_t *)frame+2u);
    ++tos_xbios_opcount[fn&0xffu];
    switch(fn){
    /* XBIOS 14 Iorec(dev): a real ring queue for keyboard/mouse/MIDI - LDW uses
       it as its input queue right before Kbdvbase. */
    case 14u: {int dev=(int)(int16_t)a[0];
               ++kdbg_tos_xbios14;
               if(dev<0||dev>2)return 0;
               return (int32_t)(uintptr_t)tos_iorec[dev];}
    /* XBIOS 34 Kbdvbase(): the KBDVECS whose 5th pointer ($10) is mousevec.
       Returning 0 made LDW read NULL+16, i.e. address $10. */
    case 34u: ++kdbg_tos_xbios34;
              return (int32_t)(uintptr_t)tos_kbdvecs;
    /* ---- audio (XBIOS 28..32).  Real contracts, not "return 0" ----------
       28 Giaccess(data,reg): bit 7 of reg set means WRITE, otherwise READ the
          selected register (EmuTOS bios/sound.c).  Registers 0..13 are
          write-only on the chip, so a read returns the driver's record of what
          was written.
       29 Offgibit(mask) / 30 Ongibit(mask): PSG port A, AND / OR the mask, with
          the direction bits untouched (they go through the atomic helper).
       31 Xbtimer: still unimplemented, and it says so (-32 EINVFN) instead of
          pretending success.
       32 Dosound(table): returns the previous table pointer; a negative pointer
          stops playback; the sequence is stepped by the Timer C interrupt, so it
          keeps playing while the program computes. */
    case 28u: {uint32_t reg=(uint32_t)(a[1]&0xffu),val=(uint32_t)(a[0]&0xffu);
               uint32_t idx=reg&0x0fu;
               if(reg&0x80u){
                   if(idx>=14u){
                       /* Ports 14/15 are virtualised (see tos_vport_a above). */
                       if(idx==14u)tos_vport_a=(uint8_t)val;else tos_vport_b=(uint8_t)val;
                       ++kdbg_tos_vport_w;
                       return (int32_t)tos_vport_read(idx);
                   }
                   /* One atomic operation: the owner rule and the write cannot be
                      separated, or a native application could claim the chip in
                      between (audit P1.4). */
                   if(kaudio_tos_reg_write((uint8_t)idx,(uint8_t)val)<0){
                       ++kdbg_tos_audio_refused;return 0;
                   }
                   ++kdbg_tos_xbios28w;
                   return (int32_t)psg_shadow((uint8_t)idx);   /* TOS returns the read too */
               }
               ++kdbg_tos_xbios28r;
               if(idx>=14u)return (int32_t)tos_vport_read(idx);
               return (int32_t)psg_shadow((uint8_t)idx);}
    case 29u: ++kdbg_tos_xbios29;
              tos_vport_a=(uint8_t)(tos_vport_a&(uint8_t)(a[0]&0xffu));  /* AND, jak TOS */
              ++kdbg_tos_vport_w;return 0;
    case 30u: ++kdbg_tos_xbios30;
              tos_vport_a=(uint8_t)(tos_vport_a|(uint8_t)(a[0]&0xffu));  /* OR, jak TOS */
              ++kdbg_tos_vport_w;return 0;
    case 31u: ++kdbg_tos_xbios31;return -32;              /* EINVFN: Xbtimer */
    case 32u: {uint32_t table=((uint32_t)a[0]<<16)|(uint32_t)a[1];
               const uint8_t *end=0;
               ++kdbg_tos_xbios32;
               if(table&&(int32_t)table>=0){
                   end=tos_table_end((const uint8_t *)(uintptr_t)table);
                   if(!end){
                       /* Not a buffer we know: refuse instead of letting the Timer C
                          interpreter walk memory the program may not own. */
                       ++kdbg_tos_audio_refused;
                       return (int32_t)(intptr_t)kaudio_dosound(0);   /* stop, politely */
                   }
               }
               return (int32_t)(intptr_t)kaudio_dosound_span((const uint8_t *)(uintptr_t)table,end);}
    case 2u: case 3u: return (int32_t)(uintptr_t)(tos_screen?tos_screen:(uint8_t *)(uintptr_t)0x00C00000UL); /* Physbase/Logbase (never 0) */
    case 4u: return (int32_t)tos_mode;                                    /* Getrez */
    case 5u: {uint32_t log=((uint32_t)a[0]<<16)|a[1];                     /* Setscreen(log,phys,rez) */
              int16_t rez=(int16_t)a[4];                   /* rez is a WORD, not a long */
              /* -1 (0xFFFFFFFF) and 0 both mean "keep the current screen".
                 The old `if(log)` treated -1 as a real address and clobbered
                 the private buffer with 0xFFFFFFFF. */
              if(log&&log!=0xffffffffUL)tos_screen=(uint8_t *)(uintptr_t)log;
              if(rez>=0&&rez<=2)tos_mode=(uint8_t)rez;
              /* A running window must follow the program's new resolution. */
              tos_window_geometry_changed();
              tos_desktop_pending=1u;
              return 0;}
    case 6u: {uint32_t p=((uint32_t)a[0]<<16)|a[1];int k;                 /* Setpalette */
              if(p){const uint16_t *s=(const uint16_t *)(uintptr_t)p;for(k=0;k<16;k++)tos_palette[k]=s[k];}
              if(tos_desktop_active)tos_apply_palette();
              return 0;}
    case 7u: { /* Setcolor(index,-1) queries without changing the palette. */
        uint16_t idx=a[0],col=a[1],old;
        if(idx>=16u)return -1;
        old=tos_palette[idx];
        if((int16_t)col>=0){tos_palette[idx]=col&0x777u;
            if(tos_desktop_active)tos_apply_palette();}
        return old;}
    case 37u: /* Vsync: mark that a frame is ready.  It must NOT bypass the
                 presentation deadline: GEM programs call Vsync constantly (the
                 AES event loop does it internally), and every forced present
                 costs a full damage scan + convert + compose + flush.  That is
                 what made a drawn menu take seconds - ~1.3 ms per rectangle,
                 thousands of rectangles per page.  The regular content deadline
                 (25 Hz) now coalesces them; a frame is never lost, only merged. */
              tos_composite_pending=1u;return 0;
    case 38u: {                                                           /* Supexec */
        /* Run a user callback in supervisor mode.  TOS leaves the callback
           argument in d3; the trap stub saved the user's d3 at frame-48, so
           pass it back.  SysInfo reads AES global[0] this way when deciding
           whether it is allowed to run. */
        uint32_t fnptr=((uint32_t)a[0]<<16)|a[1];
        uint32_t arg3=frame?rd32((const uint8_t *)frame-48u):0u;
        if(!fnptr)return 0;
        return (int32_t)asf_tos_supexec((void *)(uintptr_t)fnptr,arg3);
    }
    case 0x00feu: {                                                       /* ASF control */
        uint16_t cmd=a[0];
        switch(cmd){
        case 0u: kblock_cache_enable(0u);tos_print("SMARTDRV: CACHE OFF\n");return 0;
        case 1u: kblock_cache_enable(1u);tos_print("SMARTDRV: CACHE ON, ");
                 tos_dec(kblock_cache_slots());tos_print(" sectors\n");return 0;
        case 2u: return (int32_t)kernel_wall_ticks;
        case 3u: return (int32_t)kblock_cache_hits();
        case 4u: return (int32_t)kblock_cache_misses();
        case 5u: tos_diskpd();return 0;
        case 6u: kblock_cache_release();tos_print("SMARTDRV: CACHE OFF + CLEARED\n");return 0;
        case 7u: tos_window_enabled=1u;tos_print("T2: WINDOW MODE ON\n");return 0;
        case 10u: {                                           /* raw IKBD ring dump */
            int32_t i;
            const char *hx="0123456789ABCDEF";
            tos_print("IKBD TOTAL: ");tos_dec((uint32_t)kernel_ikbd_raw_total());
            tos_print("  DROPPED: ");tos_dec((uint32_t)kernel_ikbd_drop_count());tos_print("\n");
            tos_print("RAW (data:status), newest last:\n");
            for(i=23;i>=0;i--){
                int32_t v=kernel_ikbd_raw_last((uint32_t)i);
                uint8_t d,st;
                if(v<0)continue;
                d=(uint8_t)v;st=(uint8_t)((uint32_t)v>>8);
                tos_putc(hx[(d>>4)&15u]);tos_putc(hx[d&15u]);tos_putc(':');
                tos_putc(hx[(st>>4)&15u]);tos_putc(hx[st&15u]);tos_putc(' ');
            }
            tos_print("\n");
            return 0;
        }
        case 9u: {                                                       /* log hex dump */
            int32_t n=kernel_console_log_count(),k;
            tos_print("LOG LINES: ");tos_dec((uint32_t)n);tos_print("\n");
            for(k=(n>3?n-3:0);k<n;k++){
                const char *s=kernel_console_log_line(k);
                int j;
                tos_print("L");tos_dec((uint32_t)k);tos_print(": ");
                for(j=0;s[j]&&j<40;j++){
                    const char *hx="0123456789ABCDEF";
                    tos_putc(hx[((uint8_t)s[j]>>4)&15u]);
                    tos_putc(hx[(uint8_t)s[j]&15u]);
                    tos_putc(' ');
                }
                tos_print("\n");
            }
            return 0;
        }
        case 8u: tos_window_enabled=0u;
                 if(tos_desktop_active)tos_desktop_leave();   /* back to text */
                 tos_print("T2: WINDOW MODE OFF\n");return 0;
        default: return 0;
        }
    }
    default: return 0;
    }
}

static void tos_diskpd(void);

/* --- DISKPD: short disk benchmark (write/read/seek) ----------------------- */
static void tos_diskpd(void)
{
    static const char path[]="\\DISKPD.TMP";
    uint32_t chunk=8192u,total=64u*1024u,i,t0,t1,wt,rt,st,kbs,guard;
    uint8_t *buf=0;
    if(kfat_create_path(path)!=FAT_FILE_FOUND){tos_print("DISKPD: cannot create temp file\n");return;}
    buf=(uint8_t *)kmem_alloc(chunk,512u,KMEM_OWNER_KERNEL,KMEM_READ|KMEM_WRITE,1);
    if(!buf){tos_print("DISKPD: no memory\n");return;}
    for(i=0u;i<chunk;i++)buf[i]=(uint8_t)(i*7u);
    tos_print("DISKPD 1.0 - 64 KB write/read + 12 random reads\n");
    tos_print("  cache: ");tos_print(kblock_cache_sectors()?"ON":"OFF");tos_print("\n");
    t0=(uint32_t)kernel_wall_ticks;
    guard=0u;{uint32_t off=0u,w=0u;while(off<total&&guard++<200u){if(kfat_write_path_at(path,off,buf,chunk,&w)!=FAT_FILE_FOUND)break;if(!w)break;off+=w;}}
    t1=(uint32_t)kernel_wall_ticks;wt=t1-t0;
    t0=(uint32_t)kernel_wall_ticks;
    guard=0u;{uint32_t off=0u,g=0u;while(off<total&&guard++<200u){if(kfat_read_path_at(path,off,buf,chunk,&g)!=FAT_FILE_FOUND)break;if(!g)break;off+=g;}}
    t1=(uint32_t)kernel_wall_ticks;rt=t1-t0;
    t0=(uint32_t)kernel_wall_ticks;
    {uint32_t seed=12345u,k;for(k=0u;k<12u;k++){uint32_t o,g;
        seed=seed*1103515245u+12345u;o=((seed>>9)%(total/512u))*512u;
        if(kfat_read_path_at(path,o,buf,512u,&g)!=FAT_FILE_FOUND)break;}}
    t1=(uint32_t)kernel_wall_ticks;st=t1-t0;
    tos_print("  write: ");tos_dec(wt);tos_print(" ticks (");tos_dec(wt*20u);tos_print(" ms) ");
    kbs=wt?((total/1024u)*50u/wt):0u;tos_dec(kbs);tos_print(" KB/s\n");
    tos_print("  read : ");tos_dec(rt);tos_print(" ticks (");tos_dec(rt*20u);tos_print(" ms) ");
    kbs=rt?((total/1024u)*50u/rt):0u;tos_dec(kbs);tos_print(" KB/s\n");
    tos_print("  seek : ");tos_dec(st);tos_print(" ticks/12 reads, avg ");
    tos_dec(st*20u/12u);tos_print(" ms\n");
    kfat_delete_path(path);
    kmem_free(buf,KMEM_OWNER_KERNEL);
}

/* --- AES/VDI (trap #2): LEGACY / EXPERIMENTAL stub ------------------------- */
static uint8_t aes_windows;
static int16_t aes_geom[8][4];
uint16_t tos_aes_trace[64];      /* [0..31]=opcode, [32..63]=intin[0] */
uint32_t tos_aes_trace_n;
/* Full request/response log for the first 64 GEM calls: lets us see exactly
   which AES/VDI operations SysInfo asks for and what we answered.
   Layout per call: [0]=is_aes, [1..6]=contrl[0..5], [7..10]=intin[0..3],
   [11..14]=intout[0..3], [15]=result. */
uint16_t tos_aes_log[64*32];   /* 16 declared outputs per call */
uint32_t tos_aes_log_n;
/* AES version advertised through appl_init.  TOS v4.x reports 0x0340; we keep
   the EmuTOS "modern but not 3D" value.  SysInfo only needs it to be non-zero,
   but the number also tells applications which AES calls to expect. */
#define TOS_AES_VERSION 0x0330u
/* Command line passed to the running TOS program; shel_read() hands it back. */
static char tos_cmdline[128];
/* The TOS persona runs synchronously inside asf_tos_enter, so the kernel main
   loop (and with it the compositor) is blocked for the whole program.  Pump
   one composite from the app's event loop so its window actually reaches the
   screen while it is alive. */

/* Deliver a WM_REDRAW to the app's evnt_multi message buffer once, so it
   paints its page instead of waiting forever for a window expose. */
static uint8_t tos_redraw_sent;
static char tos_win_name[64];   /* WF_NAME answer */
/* AES message queue.  A GEM program blocks in evnt_mesag/evnt_multi until the
   window manager hands it a message (WM_REDRAW being the one every program
   waits for right after opening a window).  Answering "no message" immediately
   made such programs spin forever - reported as "LDW hung the system". */
#define TOS_MSG_MAX 8
static int16_t tos_msgq[TOS_MSG_MAX][8];
static uint8_t tos_msgq_head,tos_msgq_tail;
static int16_t tos_redraw_msg[8];
static void tos_msg_post(const int16_t *m)
{
    uint8_t next=(uint8_t)((tos_msgq_tail+1u)%TOS_MSG_MAX);
    unsigned i;
    if(next==tos_msgq_head)return;                 /* full: drop the oldest need */
    for(i=0;i<8u;++i)tos_msgq[tos_msgq_tail][i]=m[i];
    tos_msgq_tail=next;
}
static int tos_msg_take(int16_t *out)
{
    unsigned i;
    if(tos_msgq_head==tos_msgq_tail)return 0;
    for(i=0;i<8u;++i)out[i]=tos_msgq[tos_msgq_head][i];
    tos_msgq_head=(uint8_t)((tos_msgq_head+1u)%TOS_MSG_MAX);
    return 1;
}
static void tos_msg_redraw(void);   /* needs the window geometry, defined below */

/* wind_get(WF_FIRSTXYWH/NEXTXYWH) cursor: one client rectangle then end. */
static uint8_t aes_wg_first;
/* Diagnostics: how many keys/messages evnt_multi actually handed to the app. */
uint32_t tos_evkbd_n,tos_evmes_n,tos_evmulti_n;

/* --- minimal AES resource/object support (rsrc_*, form_*, objc_draw) ------ */
#define AES_OBJ_SIZE 24
static int16_t aes_w(const uint8_t *p){return (int16_t)(((uint16_t)p[0]<<8)|p[1]);}
static uint16_t aes_u(const uint8_t *p){return (uint16_t)(((uint16_t)p[0]<<8)|p[1]);}

/* rsrc_obfix(): convert the packed character coordinates of one object
   (ob_x,ob_y,ob_w,ob_h) to pixels, as the AES does after loading a resource. */
static void aes_obfix(uint8_t *tree,int obj)
{
    uint8_t *o=tree+(uint32_t)(uint16_t)obj*AES_OBJ_SIZE;
    int type=aes_w(o+6);
    int is_text;
    /* Real GEM converts CHARACTER coordinates to pixels only for the text-like
       object types; G_BOX/G_IBOX/G_IMAGE already carry pixels and must be left
       alone.  Multiplying everything by 8/16 corrupted pixel-sized objects
       (a width of 300 became 300*8 = 2400 and wrapped), and a wrapped value of
       0 is exactly the kind of divisor that killed the caller. */
    switch(type){
    case 11: case 12: case 21: case 22: case 23:      /* BOXTEXT/TITLE/TEXT/FTEXT/FBOXTEXT */
    case 25: case 26: case 28: case 29: case 30:      /* BOXCHAR/BUTTON/STRING/ICON/CICON */
        is_text=1;break;
    default:
        is_text=0;break;
    }
    if(!is_text)return;                     /* pixels: nothing to convert */
    {uint8_t *g=o+16;
     static const int mul[4]={8,16,8,16};
     int i;
     for(i=0;i<4;i++){
         uint16_t w=(uint16_t)(((uint16_t)g[i*2]<<8)|g[i*2+1]);
         int coff=(w>>8)&0xff,cpos=w&0xff,r;
         if(i==2&&cpos==80)r=640;else r=cpos*mul[i];
         r+=(coff>128)?(coff-256):coff;
         if(r<0)r=0;
         g[i*2]=(uint8_t)(r>>8);g[i*2+1]=(uint8_t)r;
     }}
}

/* Trees must be walked defensively: a cyclic or malformed resource link would
   otherwise recurse forever.  A fixed node budget bounds the work. */
uint32_t aes_dbg_tree,aes_dbg_type;
/* AES opcode histogram: which GEM functions SysInfo actually uses. */
uint32_t tos_aes_opcount[256];
/* --- Diagnostics the hardware audit asked for -----------------------------
   Record the FIRST unsupported call per layer with the CALLER's PC, and count
   faults and normal exits separately, so "why did it stop" is answerable
   without guessing.  Return values are deliberately NOT changed here: the
   contract of each function differs (pointer / status / void), so a blanket
   -32 would be wrong. */
uint32_t kdbg_unsup_layer,kdbg_unsup_fn,kdbg_unsup_pc,kdbg_unsup_count;
/* Every unsupported call, in order (layer<<16|fn), so the trail can be listed
   instead of guessing from one sample. */
uint32_t kdbg_unsup_ring[32];
static uint32_t tos_unsup_head;
uint32_t kdbg_exit_normal,kdbg_exit_fault;
static uint32_t tos_last_caller_pc;
/* One record per unsupported call: layer, function, caller PC, the first four
   arguments (as the program passed them) and the value we return.  A bare
   "unsupported" says nothing about WHY the program ended, and the termination
   is recorded separately (normal Pterm vs exception). */
#define TOS_UNSUP_MAX 16
uint32_t kdbg_unsup_rec[TOS_UNSUP_MAX][8];
static void tos_note_unsupported_at(int layer,uint32_t fn,int32_t result,
                                    const int16_t *args,int nargs)
{
    uint32_t *e;
    ++kdbg_unsup_count;
    e=kdbg_unsup_rec[tos_unsup_head%TOS_UNSUP_MAX];
    e[0]=((uint32_t)layer<<16)|(fn&0xffffu);
    e[1]=tos_last_caller_pc;
    e[2]=(uint32_t)result;
    e[3]=nargs>0&&args?(uint32_t)(uint16_t)args[0]:0u;
    e[4]=nargs>1&&args?(uint32_t)(uint16_t)args[1]:0u;
    e[5]=nargs>2&&args?(uint32_t)(uint16_t)args[2]:0u;
    e[6]=nargs>3&&args?(uint32_t)(uint16_t)args[3]:0u;
    e[7]=tos_unsup_head;                       /* sequence number */
    ++tos_unsup_head;
    if(kdbg_unsup_count==1u){                 /* first one only: the trail head */
        kdbg_unsup_layer=(uint32_t)layer;
        kdbg_unsup_fn=fn;
        kdbg_unsup_pc=tos_last_caller_pc;
    }
}
void tos_note_unsupported(int layer,uint32_t fn)
{
    tos_note_unsupported_at(layer,fn,0,0,0);
}
/* Termination record: normal exit and exception are counted separately. */
uint32_t kdbg_term_normal,kdbg_term_code,kdbg_term_fault,kdbg_term_vector,kdbg_term_pc;
/* Bounding box of a dialog tree: walk the child chain (bounded) and take the
   union of every object's absolute rectangle. */
static void aes_tree_bbox_rec(const uint8_t *tree,int obj,int xo,int yo,
                              int16_t *bx,int16_t *by,int16_t *bw,int16_t *bh,int *budget)
{
    const uint8_t *o;int c,x,y,w,h;
    if(obj<0||obj>1024||*budget<=0)return;
    --*budget;
    o=tree+(uint32_t)obj*AES_OBJ_SIZE;
    x=xo+aes_w(o+16);y=yo+aes_w(o+18);w=aes_w(o+20);h=aes_w(o+22);
    if(w>0&&h>0){
        if(*bw==0&&*bh==0){*bx=(int16_t)x;*by=(int16_t)y;*bw=(int16_t)w;*bh=(int16_t)h;}
        else{
            int x2=x+w,y2=y+h,bx2=*bx+*bw,by2=*by+*bh;
            if(x<*bx)*bx=(int16_t)x;
            if(y<*by)*by=(int16_t)y;
            if(x2>bx2)bx2=x2;
            if(y2>by2)by2=y2;
            *bw=(int16_t)(bx2-*bx);*bh=(int16_t)(by2-*by);
        }
    }
    c=aes_w(o+2);
    while(c>=0&&c<=1024&&c!=obj&&*budget>0){
        aes_tree_bbox_rec(tree,c,x,y,bx,by,bw,bh,budget);
        {const uint8_t *co=tree+(uint32_t)c*AES_OBJ_SIZE;c=aes_w(co+0);
         if(c==0&&aes_w(co+2)==0)break;}
    }
}
static void aes_tree_bbox(const uint8_t *tree,int16_t *bx,int16_t *by,int16_t *bw,int16_t *bh)
{
    int budget=512;
    *bx=0;*by=0;*bw=0;*bh=0;
    aes_tree_bbox_rec(tree,0,0,0,bx,by,bw,bh,&budget);
}

static int aes_obj_offset(const uint8_t *tree,int obj,int wanted,int xo,int yo,
                          int *outx,int *outy,int *budget)
{
    const uint8_t *o;int c,x,y;
    if(obj<0||obj>1024||*budget<=0)return 0;
    --*budget;o=tree+(uint32_t)obj*AES_OBJ_SIZE;
    x=xo+aes_w(o+16);y=yo+aes_w(o+18);
    if(obj==wanted){*outx=x;*outy=y;return 1;}
    c=aes_w(o+2);
    while(c>=0&&c<=1024&&c!=obj&&*budget>0){
        int next;
        if(aes_obj_offset(tree,c,wanted,x,y,outx,outy,budget))return 1;
        next=aes_w(tree+(uint32_t)c*AES_OBJ_SIZE);
        if(next==c)break;
        c=next;
    }
    return 0;
}

/* objc_find returns the deepest visible object under the pointer, or -1.
   A successful hit is an object INDEX, never a generic success boolean. */
static int aes_obj_find(const uint8_t *tree,int obj,int xo,int yo,int depth,
                        int mx,int my,int *budget)
{
    const uint8_t *o;int x,y,c,found;
    if(obj<0||obj>1024||*budget<=0)return -1;
    --*budget;o=tree+(uint32_t)obj*AES_OBJ_SIZE;
    if(aes_u(o+8)&0x0080u)return -1;
    x=xo+aes_w(o+16);y=yo+aes_w(o+18);
    if(mx<x||my<y||mx>=x+aes_w(o+20)||my>=y+aes_w(o+22))return -1;
    found=obj;
    if(depth==0)return found;
    c=aes_w(o+2);
    while(c>=0&&c<=1024&&c!=obj&&*budget>0){
        int next,hit=aes_obj_find(tree,c,x,y,depth-1,mx,my,budget);
        if(hit>=0)found=hit;
        next=aes_w(tree+(uint32_t)c*AES_OBJ_SIZE);
        if(next==c)break;
        c=next;
    }
    return found;
}

/* ---- AES drawing clip ----------------------------------------------------
   objc_draw/objc_change both carry a clipping rectangle (intin[2..5]) that the
   renderer ignored completely: a request to repaint 8x16 pixels repainted a
   whole 640x400 panel - 258080 requested pixels instead of 128 (2016x).  Every
   primitive now intersects with this context, invisible work is skipped and the
   damage reported is only what was actually painted. */
static int aes_clip_on;
static int aes_clip_x0,aes_clip_y0,aes_clip_x1,aes_clip_y1;
static void aes_clip_set(int x,int y,int w,int h)
{
    aes_clip_x0=x;aes_clip_y0=y;aes_clip_x1=x+w;aes_clip_y1=y+h;
    if(aes_clip_x0<0)aes_clip_x0=0;
    if(aes_clip_y0<0)aes_clip_y0=0;
    if(aes_clip_x1>640)aes_clip_x1=640;
    if(aes_clip_y1>400)aes_clip_y1=400;
    aes_clip_on=1;
}
static void aes_clip_clear(void){aes_clip_on=0;}
static int aes_clip_visible(void){return !aes_clip_on||(aes_clip_x1>aes_clip_x0&&aes_clip_y1>aes_clip_y0);}
/* Intersect a rectangle with the clip; 0 means "nothing visible". */
static int aes_clip_rect(int *x,int *y,int *w,int *h)
{
    int x1,y1;
    if(*w<=0||*h<=0)return 0;
    if(!aes_clip_on)return 1;
    x1=*x+*w;y1=*y+*h;
    if(*x<aes_clip_x0)*x=aes_clip_x0;
    if(*y<aes_clip_y0)*y=aes_clip_y0;
    if(x1>aes_clip_x1)x1=aes_clip_x1;
    if(y1>aes_clip_y1)y1=aes_clip_y1;
    *w=x1-*x;*h=y1-*y;
    return (*w>0&&*h>0);
}
#define AES_CLIP_FILL(rx,ry,rw,rh,ink) do{int _x=(rx),_y=(ry),_w=(rw),_h=(rh); \
    if(aes_clip_rect(&_x,&_y,&_w,&_h))tos_vdi_fill_rect(_x,_y,_w,_h,(ink));}while(0)
/* Text is clipped per character: a partially visible string must not paint
   outside the caller's rectangle, which is how a partial redraw smeared over
   neighbouring objects. */
static void aes_obj_text(const char *s,int x,int y,int ink)
{
    int i=0,n=0;
    if(!s)return;
    if(!aes_clip_on){tos_vdi_text(x,y,s,ink,1);return;}
    while(s[i]){++n;++i;}
    /* Fully visible string: one call, no clipping work. */
    {   int tx=x,ty=y-16,tw=n*8,th=16;
        if(aes_clip_rect(&tx,&ty,&tw,&th)&&tx==x&&ty==y-16&&tw==n*8&&th==16){
            tos_vdi_text(x,y,s,ink,1);
            return;
        }
    }
    /* Border case: checking the cell is NOT enough - the glyph writer must clip
       the MASK, otherwise a solid 8x16 glyph with a 1x1 clip still asks for 128
       pixels in 16 spans that leave the rectangle (the audit's measurement).
       The AES rectangle is handed to the VDI as a glyph clip, so the
       application's own vs_clip state is left alone. */
    tos_vdi_text_clip(aes_clip_x0,aes_clip_y0,aes_clip_x1,aes_clip_y1);
    for(i=0;s[i];++i){
        int cx=x+i*8,cy=y-16,cw=8,ch=16;
        if(aes_clip_rect(&cx,&cy,&cw,&ch)){char b[2];b[0]=s[i];b[1]=0;tos_vdi_text(x+i*8,y,b,ink,1);}
    }
    tos_vdi_text_clip_off();
}
static void aes_obj_draw(const uint8_t *tree,int obj,int xo,int yo,int depth,int *budget)
{
    const uint8_t *o;int type,x,y,w,h,c,selected;
    if(obj<0||obj>1024||depth<0||*budget<=0)return;
    (*budget)--;
    o=tree+(uint32_t)(uint16_t)obj*AES_OBJ_SIZE;
    if(aes_u(o+8)&0x0080u)return; /* OF_HIDETREE */
    selected=(aes_u(o+10)&1u)!=0;
    type=(int)(aes_u(o+6)&0xffu); /* high byte is application-defined */
    x=xo+aes_w(o+16);y=yo+aes_w(o+18);w=aes_w(o+20);h=aes_w(o+22);
    switch(type){
    case 20: case 22: case 26: case 27: case 30: /* BOX/BOXTEXT/BUTTON/BOXCHAR/FBOXTEXT */
        if(w>0&&h>0){
            AES_CLIP_FILL(x,y,w,h,selected?1:0);
            AES_CLIP_FILL(x,y,w,1,1);
            AES_CLIP_FILL(x,y+h-1,w,1,1);
            AES_CLIP_FILL(x,y,1,h,1);
            AES_CLIP_FILL(x+w-1,y,1,h,1);
        }
        break;
    default:
        /* Unknown object type.  SysInfo's panel root reads as ob_type 0x7114
           instead of G_BOX, and a strict switch silently dropped the panel /
           button frames because of it.  Draw the frame anyway when the type is
           outside the whole GEM range and the rectangle is panel-sized. */
        if((type<20||type>32)&&w>=16&&h>=16){
            AES_CLIP_FILL(x,y,w,1,1);
            AES_CLIP_FILL(x,y+h-1,w,1,1);
            AES_CLIP_FILL(x,y,1,h,1);
            AES_CLIP_FILL(x+w-1,y,1,h,1);
        }
        break;
    }
    if(type==21||type==22||type==29||type==30){        /* text objects: TEDINFO */
        const uint8_t *td=(const uint8_t *)(uintptr_t)rd32(o+12);
        if(td){const char *s=(const char *)(uintptr_t)rd32(td);if(s)aes_obj_text(s,x,y+(h+16)/2,selected?0:1);}
    }else if(type==26||type==28||type==32){  /* direct string */
        const char *s=(const char *)(uintptr_t)rd32(o+12);
        if(s){int n=0;while(s[n])++n;
            aes_obj_text(s,type==26?x+(w-n*8)/2:x,y+(h+16)/2,selected?0:1);}
    }
    if(depth>0){
        c=aes_w(o+2);
        while(c>=0&&c<=1024&&c!=obj&&*budget>0){
            aes_obj_draw(tree,c,x,y,depth-1,budget);
            {const uint8_t *n=tree+(uint32_t)(uint16_t)c*AES_OBJ_SIZE;int nc=aes_w(n);
             if(nc==c)break;
         c=nc;}
        }
    }
}
static int32_t tos_aes_dispatch(const int16_t *contrl,const int16_t *intin,
                                const int16_t *ptsin,int16_t *intout,int16_t *ptsout,
                                const uint8_t *global,void **addrin,void **addrout)
{
    (void)ptsin;(void)ptsout;(void)addrout;
    /* AES entry points (GEM passes the AES opcode in contrl[0]). */
    switch(contrl[0]){
    case 10:                                    /* appl_init */
        /* GEM fills the AESGLOBAL block through the AESPB global pointer:
           ap_version, ap_count, ap_id, ap_private, ap_ptree, ap_rscmem,
           ap_rsclen, ap_planes, ap_3resv, ap_4resv (30 bytes).  SysInfo reads
           global[0] (ap_version) at startup and, when the AES never set it,
           refuses to run with DON'T PUT SYSINFO IN THE AUTO FOLDER. */
        if(global){
            uint8_t *g=(uint8_t *)(uintptr_t)global;
            int k;
            for(k=0;k<30;k++)g[k]=0u;
            g[0]=(uint8_t)(TOS_AES_VERSION>>8);g[1]=(uint8_t)TOS_AES_VERSION;
            g[3]=1u;                        /* ap_count  = 1 */
            g[5]=1u;                        /* ap_id     = 1 */
            g[21]=1u;                       /* ap_planes = 1 (mono) */
        }
        /* appl_init declares ONE output WORD (ap_id).  It used to write four
           (id, version, 0x0300, 0x0100), which corrupts whatever follows an
           exactly sized intout[] - the caller's own variables. */
        if(intout)intout[0]=1;
        return 1;
    case 19:                                    /* appl_exit */
        return 1;
    case 77:                                    /* graf_handle */
        /* graf_handle -> handle, char w/h, box w/h.  The box metrics (1 and 0
           before) are what GEM uses to size button/border frames. */
        if(intout){intout[0]=1;intout[1]=8;intout[2]=16;intout[3]=11;intout[4]=19;}
        if(ptsout){ptsout[0]=640;ptsout[1]=400;}
        return 1;
    case 78:                                    /* graf_mouse */
        return 1;
    /* Menu: bar/title/item/icheck/tnormal/attach/text. No-op for now but a
       defined answer, so the application does not follow a null pointer. */
    case 30: case 31: case 32: case 33: case 34: case 35: case 36:
        return 1;
    /* Object tree: objc_add/delete/draw/find/offset/order/edit/change/sysvar.
       draw needs the real tree walk; the rest are safe for now. */
    case 44: { /* objc_offset: result, absolute x, absolute y */
        int x=0,y=0,budget=2048,ok=0;
        if(addrin&&addrin[0]&&intin)
            ok=aes_obj_offset(addrin[0],0,intin[0],0,0,&x,&y,&budget);
        if(intout){intout[1]=(int16_t)x;intout[2]=(int16_t)y;}
        return ok;
    }
    case 43: { /* objc_find(tree,start,depth,mx,my) */
        int x=0,y=0,budget=2048,obj;
        const uint8_t *tree;
        if(!addrin||!addrin[0]||!intin)return -1;
        tree=addrin[0];obj=intin[0];
        if(!aes_obj_offset(tree,0,obj,0,0,&x,&y,&budget))return -1;
        x-=aes_w(tree+(uint32_t)obj*24u+16u);
        y-=aes_w(tree+(uint32_t)obj*24u+18u);
        budget=2048;
        return aes_obj_find(tree,obj,x,y,intin[1],intin[2],intin[3],&budget);
    }
    case 40: case 41:
    case 45: case 46: case 48:
        return 1;
    case 20: {                                  /* evnt_keybd -> scan<<8|ASCII */
        /* Returning the ASCII alone made an arrow key look like "no key":
           Up = scancode 0x48, ASCII 0 -> 0x0000 instead of 0x4800.  evnt_multi
           already packed it as scan<<8|ASCII; the single-key call did not.
           GEM's evnt_keybd waits for a key, so wait - bounded, pumping input. */
        uint32_t key;unsigned guard=0;uint32_t start=tos_mfp_ticks;
        for(;;){
            if(tos_key_ready()){
                key=(uint32_t)tos_getkey();
                return (int32_t)(((key>>8)&0xff00u)|(key&0xffu));
            }
            if(++guard>20000u)break;
            tos_poll_input();tos_clock_tick();tos_composite_work();
            if(tos_exit_pending()){tos_exit_code=0;asf_tos_exit();return 0;}
            if((uint32_t)(tos_mfp_ticks-start)>=200u)break;   /* ~1 s per pass */
        }
        return 0;}
    case 21:                                    /* evnt_button */
    case 22: {                                  /* evnt_mouse  */
        /* AES output arrays: intout[0] is the RETURN CODE (asf_tos_aesvdi
           writes it after the dispatch), so mx,my,buttons,modifiers belong in
           intout[1..4].  The previous version wrote them at [0..3] and the
           return code overwrote mx - the audit's "[1,90,1,4,21845]" result.
           evnt_mouse flags are 0 = wait for ENTER, 1 = wait for LEAVE (not a
           bit mask), and evnt_button must count the requested clicks. */
        int is_mouse=(contrl[0]==22);
        uint16_t want_mask=(uint16_t)(intin?(uint16_t)intin[is_mouse?0:1]:0u);
        uint16_t want_state=(uint16_t)(intin?(uint16_t)intin[is_mouse?0:2]:0u);
        int want_clicks=(int)(intin?(uint16_t)intin[0]:1);
        int32_t rx=0,ry=0,rw=0,rh=0;
        int16_t m[5];unsigned guard=0;uint32_t start=tos_mfp_ticks;
        int clicks=0,last_buttons=-1;
        if(is_mouse&&intin){rx=(int16_t)intin[1];ry=(int16_t)intin[2];
                            rw=(int16_t)intin[3];rh=(int16_t)intin[4];}
        if(want_clicks<1)want_clicks=1;
        for(;;){
            int hit=0;
            tos_poll_input();tos_mouse_state(m);
            if(m[3]!=last_buttons){last_buttons=m[3];++clicks;}
            if(is_mouse){
                int inside=m[1]>=rx&&m[2]>=ry&&(int32_t)m[1]<rx+rw&&(int32_t)m[2]<ry+rh;
                /* flags: 0 = entered the rectangle, 1 = left it */
                hit=((want_mask!=0u)?(!inside):(inside))?1:0;
            }else{
                if((m[3]&want_mask)==(want_state&want_mask)&&clicks>=want_clicks)hit=1;
            }
            if(hit){
                if(intout){intout[1]=m[1];intout[2]=m[2];intout[3]=m[3];intout[4]=m[4];}
                if(is_mouse)++kdbg_evmouse_n;else ++kdbg_evbtn_n;
                return 1;
            }
            if(++guard>20000u)break;                       /* hard cap */
            tos_clock_tick();tos_composite_work();
            if(tos_exit_pending()){tos_exit_code=0;asf_tos_exit();return 0;}
            if((uint32_t)(tos_mfp_ticks-start)>=200u)break;  /* ~1 s per pass */
            if(!tos_window_enabled)break;                  /* no window: no mouse */
        }
        if(intout){intout[1]=m[1];intout[2]=m[2];intout[3]=m[3];intout[4]=m[4];}
        return 0;}
    case 23: {                                  /* evnt_mesag(msg) -> 0/1 */
        /* Block (bounded) until the WM has a message.  GEM programs sit in this
           call; returning 0 immediately made them spin with no way out.
           Without a window there are no window messages at all, so a console
           program is answered at once instead of waiting for nothing. */
        if(!tos_window_enabled){if(intout)intout[0]=0;return 0;}
        uint32_t start=tos_mfp_ticks;int32_t ms=intin?((int32_t)(uint16_t)intin[0]|((int32_t)(uint16_t)intin[1]<<16)):0;
        /* Clamp: a program passing garbage milliseconds must not be able to
           block the whole machine.  A bounded wait keeps the desktop alive. */
        uint32_t wait=(uint32_t)(ms>0?ms/5+1:400);
        if(wait>1000u)wait=1000u;                         /* <= ~5 s */
        int16_t *m=(addrin&&addrin[0])?(int16_t *)addrin[0]:0;
        {unsigned guard=0;
        for(;;){
