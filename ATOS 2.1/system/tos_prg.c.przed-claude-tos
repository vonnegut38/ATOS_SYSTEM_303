/* Parameter counts differ between the two APIs:
     AES: control[1] = int_in words, control[2] = int_out words.
     VDI: control[1] = ptsin words, control[3] = intin words, control[4] = intout
          words.
   Using the VDI indices for AES read the ADDRESS-array counts, so an objc_draw
   with 11,12,13,14 was logged as 11,0,0,0 and the output count came out zero. */
static uint16_t aes_abi_in(const int16_t *contrl,int is_aes)
{
    uint16_t n=(uint16_t)((is_aes?contrl[1]:contrl[3])&0x7fffu);
    return n;
}
static uint16_t aes_abi_out(const int16_t *contrl,int is_aes)
{
    uint16_t n=(uint16_t)((is_aes?contrl[2]:contrl[4])&0x7fffu);
    return n;
}
int32_t asf_tos_aesvdi(const int16_t *contrl,const int16_t *intin,const int16_t *ptsin,
                       int16_t *intout,int16_t *ptsout,int is_aes,
                       const uint8_t *global,void **addrin,void **addrout)
{
    uint32_t slot;int32_t result;
    if(tos_exit_pending()){tos_exit_code=0;asf_tos_exit();return 0;}
    tos_clock_tick();
    if(!contrl)return 0;
    /* Diagnostics must never read past the DECLARED parameter lengths: the
       control array is five words (VDA_CTRL for AES, VDI's contrl is five too),
       and intin/intout/ptsout are sized by contrl[3]/contrl[4]/contrl[1].
       AddressSanitizer found three separate over-reads here (control, intin,
       intout) because the logger read fixed counts of six and four. */
    {   uint16_t n_in=aes_abi_in(contrl,is_aes);
        uint32_t t=tos_aes_trace_n++;
        tos_aes_trace[t&31u]=(uint16_t)contrl[0];
        tos_aes_trace[32u+(t&31u)]=(uint16_t)((intin&&n_in)?intin[0]:0);}
    /* AES and VDI opcode spaces overlap (wind_create=100=v_opnvwk), so one
       shared histogram blamed VDI work on AES opcodes.  Keep them apart. */
    /* VDI counts itself in tos_vdi_call(); counting it here too double counted
       every VDI opcode.  The point of the split is that this histogram is AES. */
    if(is_aes)++tos_aes_opcount[contrl[0]&0xffu];
    slot=tos_aes_log_n++;
    if(slot<64u){
        uint16_t *e=tos_aes_log+slot*32u;uint8_t k;
        uint16_t n_in=aes_abi_in(contrl,is_aes);
        e[0]=(uint16_t)(is_aes?1u:0u);
        /* AES control is five words; VDI's control block also carries the
           extended indices 5..10 for the MFDB calls, so only the five common
           words are logged here. */
        for(k=0u;k<5u;k++)e[1u+k]=(uint16_t)contrl[k];
        if(intin)for(k=0u;k<4u&&k<n_in;k++)e[7u+k]=(uint16_t)intin[k];
    }
    /* trap #2 selects AES (d0=0xC8) or VDI (d0=0x73); both put the opcode in
       contrl[0].  Opcodes overlap (AES wind_create = VDI v_opnvwk = 100), so
       the selector decides the dispatcher. */
    if(!is_aes)
        result=(int32_t)tos_vdi_call((uint16_t)contrl[0],(int16_t *)contrl,
                                     intin,ptsin,intout,ptsout,addrin,addrout);
    else
        result=tos_aes_dispatch(contrl,intin,ptsin,intout,ptsout,global,addrin,addrout);
    if(is_aes&&intout)intout[0]=(int16_t)result;
    /* evnt_multi is the GUI event loop: keep the compositor pumping, but do NOT
       damage the whole screen for it.  The old unconditional
       kernel_wm_damage_all() here forced a full-desktop recompose every ~16th
       call and was the last leftover of the "make it visible somehow" workaround;
       content damage now comes from the row tracking and the cursor from its own
       path. */
    tos_mark_present();
    /* Presentation has one clock-based owner: tos_composite_work(). */
    if(slot<64u){
        uint16_t *e=tos_aes_log+slot*32u;uint8_t k;
        uint16_t n_out=aes_abi_out(contrl,is_aes);
        if(intout)for(k=0u;k<16u&&k<n_out;k++)e[16u+k]=(uint16_t)intout[k];
        e[15]=(uint16_t)result;
    }
    return result;
}

