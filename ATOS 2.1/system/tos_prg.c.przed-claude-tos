/* Timer C already has a kernel ISR at approximately 50 Hz.  Count its
   interrupts, not sampled rises of TCDR: sampling once per period can keep
   seeing the same counter value and lose every wrap during Supexec. */
extern volatile uint32_t kernel_timer_ticks;
static uint32_t tos_clock_last;
static uint8_t tos_clock_ready;
static uint32_t tos_mfp_ticks=12u*720000u; /* 200 Hz, starts at noon */
static void tos_clock_tick(void)
{
    uint16_t saved_sr;uint32_t now;
    /* Called from traps and Timer C. Keep accounting + publication atomic. */
    __asm__ volatile("move.w %%sr,%0; ori.w #0x0700,%%sr":"=d"(saved_sr)::"memory");
    now=kernel_timer_ticks;
    if(tos_clock_ready)tos_mfp_ticks+=(now-tos_clock_last)*4u;
    else tos_clock_ready=1u;
    tos_clock_last=now;
    {void *p=(void *)(uintptr_t)0x4BAu;uint32_t v=tos_mfp_ticks;
     __asm__ volatile("move.l %1,%0@"::"a"(p),"d"(v):"memory");}
    __asm__ volatile("move.w %0,%%sr"::"d"(saved_sr):"memory");
}
