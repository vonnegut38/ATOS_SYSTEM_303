    sr=tos_async_lock();
    if(tos_cpu_type)tos_async_native_vbr=tos_async_read_vbr();
    if(tos_cpu_type>=2u&&tos_cpu_type<=3u)tos_async_native_cacr=tos_async_read_cacr();
    tos_async_low_copy(tos_async_native_low,(const uint32_t *)0);
    if(tos_async_state==2u){
        tos_async_low_copy((uint32_t *)0,tos_async_guest_low);
        kgfx_planar_surface_override=tos_async_target;
        kgfx_planar_surface_pitch=tos_async_pitch;
        kernel_tos_runtime_enabled=1u;
        if(tos_cpu_type)asf_tos_set_vbr(tos_async_guest_vbr);
        if(tos_cpu_type>=2u&&tos_cpu_type<=3u)tos_async_write_cacr(tos_async_guest_cacr|8u);
    }else tos_async_state=2u;
