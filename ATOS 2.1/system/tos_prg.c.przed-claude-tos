static void tos_putpixel(int x,int y,uint8_t color)
{
    if(!tos_screen||x<0||y<0)return;
    if(tos_mode==2u){if(x>=640||y>=400)return;}
    else if(tos_mode==1u){if(x>=640||y>=200)return;}
    else {if(x>=320||y>=200)return;}
    ++tos_linea_pixels;
    /* Standard ST interleaved-word layout - the SAME contract kgfx_blit_planar
       reads.  The old code wrote each plane as a separate 32000-byte block,
       which no converter (and no real ST screen) uses. */
    st_raster_set_pixel(tos_screen,tos_src_stride(),tos_src_bpp(),(uint16_t)x,(uint16_t)y,color);
    tos_note_dirty_rect(x,y,x,y);
}
static uint8_t tos_getpixel(int x,int y)
{
    if(!tos_screen||x<0||y<0)return 0u;
    if(tos_mode==2u){if(x>=640||y>=400)return 0u;}
    else if(tos_mode==1u){if(x>=640||y>=200)return 0u;}
    else {if(x>=320||y>=200)return 0u;}
    return st_raster_pixel(tos_screen,tos_src_stride(),tos_src_bpp(),(uint16_t)x,(uint16_t)y);
}
