static uint8_t tos_window_seq;
/* WM handle namespace for TOS windows.  The desktop's own dialogs use 2, 3, 5,
   6 and 7; sharing that range meant a TOS window could overwrite - or release -
   a desktop window as soon as the sequence reached those values. */
/* Client geometry follows the PROGRAM's resolution, 1:1:
     mode 0 (320x200x16) -> client 320x200, 4 planes
     mode 1 (640x200x4)  -> client 640x200, 2 planes
     mode 2 (640x400x2)  -> client 640x400, 1 plane (fixed window, no scaling) */
#define TOS_WIN_H 200
#define TOS_TITLE 18
#define TOS_STATUS_Y 424
static int32_t tos_win_w=320;                    /* window width for the mode */
static int32_t tos_client_w=320;                 /* blitted width            */
static int32_t tos_win_h=200;                    /* client height for the mode */

void tos_mouse_state_for_vdi(int16_t *out);
void tos_mouse_state_for_vdi(int16_t *out){tos_mouse_state(out);}

static void tos_mouse_state(int16_t *out)
{
    int32_t ox=tos_win_x,oy=tos_win_y+TOS_TITLE;
    int32_t x,y;
    kernel_wm_client_origin(tos_client_surface,&ox,&oy);
    x=ksessions_mouse_x()-ox;y=ksessions_mouse_y()-oy;
    if(x<0)x=0;
    if(x>=tos_client_w)x=tos_client_w-1;
    if(y<0)y=0;
    if(y>=tos_win_h)y=tos_win_h-1;
    out[1]=(int16_t)x;out[2]=(int16_t)y;
    /* ATOS also carries edge flags in bits 2+, AES accepts only held buttons. */
    out[3]=(int16_t)(tos_mouse_buttons&3u);out[4]=(int16_t)(tos_kbshift);
}

/* Source geometry of the program's screen for the current TOS mode. */
static uint16_t tos_src_stride(void)
{
    if(tos_mode==2u)return 80u;                  /* 640 px / 8, 1 plane  */
    return 160u;                                 /* mode 0 and 1: 160 B  */
}
static uint16_t tos_src_width(void){return tos_mode==0u?320u:640u;}
static uint16_t tos_src_height(void){return tos_mode==2u?400u:200u;}
static uint8_t  tos_src_bpp(void){return tos_mode==0u?4u:(tos_mode==1u?2u:1u);}
static int tos_mode_is_colour(void){return tos_mode==0u||tos_mode==1u;}

static void tos_update_window_geometry(void)
{
    tos_client_w=tos_src_width();
    tos_win_w=tos_client_w;
    tos_win_h=(int32_t)tos_src_height();
    if(tos_win_x<8)tos_win_x=8;
    if(tos_win_y<8)tos_win_y=8;
}

void kernel_tos_set_console_clear(void (*clear)(void)){console_clear_hook=clear;}

void kernel_tos_set_video(void (*enter)(void),void (*leave)(void),void (*clear)(uint8_t),
                          void (*fill)(int,int,int,int,uint8_t),
                          void (*text)(int,int,const char *,uint8_t,uint8_t),
                          void (*blit_mono)(int,int,int,int,const uint8_t *,int,uint8_t,uint8_t),
                          void (*blit_planar)(const uint8_t *,int,int,uint8_t,int,
                                              uint32_t,int,int,int,int,uint8_t))
{
    vid_enter=enter;vid_leave=leave;vid_clear=clear;
    vid_fill=fill;vid_text=text;vid_blit_mono=blit_mono;vid_blit_planar=blit_planar;
    /* NOTE: the window is NOT enabled here.  Installing the video callbacks is
       not the same event as "the user started a TOS program from the desktop":
       enabling it at bring-up made every later program depend on a flag that was
       already stale by the time a program actually ran.  The window is opened
       lazily in kernel_tos_run_program() (and by T2 opcode 7). */
}

/* One exact shadow of the private ST screen, allocated only while a window
   is open. Known writes and raw screen writes feed the same rectangle queue. */
#define TOS_SHADOW_BYTES 32000u
static tos_damage_t tos_damage;
static uint8_t *tos_shadow;
static uint8_t *tos_shadow_source;
static uint16_t tos_shadow_stride;
/* Monotonic 200 Hz counter taken from the free-running MFP Timer C.  The kernel
   timer ticks do NOT advance while a TOS program runs (the persona holds IPL 7),
   so any presentation deadline based on kernel_timer_ticks never expired and the
   screen simply did not refresh - that is the "menu takes 15 seconds" report.
   Timer C keeps counting regardless of the interrupt mask. */
/* Time base for the presentation deadlines.  The kernel tick is incremented by
   the timer interrupt, so it is monotonic and cannot lose overflows.  The
   previous version guessed MFP overflows from one short read and added 256 on
   EVERY ordinary decrement of the free-running counter (100 -> 99 became a jump
   of 255), so a single hardware step exceeded the whole presentation period -
   the deadline effectively fired at random and the earlier optimisations were
   nullified.  A short read simply cannot reconstruct missed overflows. */
uint32_t tos_now_ticks(void)
{
    return kernel_timer_ticks;
}

static uint32_t tos_last_content_tick,tos_last_cursor_tick;
uint32_t kdbg_perf_note_calls;
uint32_t kdbg_perf_dirty_rows,kdbg_perf_scan_bytes,kdbg_perf_scan_calls;
uint32_t kdbg_perf_cursor_only,kdbg_perf_presents,kdbg_perf_frames;

void tos_note_dirty_rect(int x0,int y0,int x1,int y1)
{
    int t;
    if(!tos_window_active)return;
    if(x0>x1){t=x0;x0=x1;x1=t;}
    if(y0>y1){t=y0;y0=y1;y1=t;}
    tos_damage_note(&tos_damage,x0,y0,x1+1,y1+1);
    tos_composite_pending=1u;
    ++kdbg_perf_note_calls;
}

static void tos_present_reset(void)
{
    tos_damage_reset(&tos_damage,tos_src_width(),tos_src_height());
    tos_shadow_source=tos_screen;tos_shadow_stride=tos_src_stride();
    tos_band_valid=0u;
}

/* Convert every rectangle first. No WM composition or VRAM flush per row/run.
   The mono callback accepts byte-aligned input; round only to 8 pixels. */
static void tos_convert_rect(tos_damage_rect_t *r)
{
    unsigned y,x,stride=tos_src_stride();
    if(tos_mode_is_colour()){
        r->x=0;r->w=tos_src_width();
        vid_blit_planar(tos_screen,(int)tos_src_width(),(int)tos_src_height(),
            tos_src_bpp(),(int)stride,TOS_SHADOW_BYTES,(int)tos_win_x,
            (int)(tos_win_y+TOS_TITLE),r->y,r->h,(uint8_t)TOS_CLIENT_PALETTE_BASE);
    }else{
        int right=(r->x+r->w+7)&~7;
        r->x&=~7;if(right>(int)tos_src_width())right=tos_src_width();
        r->w=right-r->x;
        vid_blit_mono((tos_client_surface?0:tos_win_x)+r->x,
            (tos_client_surface?0:tos_win_y+TOS_TITLE)+r->y,r->w,r->h,
            tos_screen+(uint32_t)r->y*stride+(unsigned)r->x/8u,(int)stride,
            (uint8_t)(TOS_CLIENT_PALETTE_BASE+1u),(uint8_t)TOS_CLIENT_PALETTE_BASE);
    }
    /* Keep the shadow coherent for API writes too. A subsequent raw write is
       detected on the next deadline; an API write does not trigger a duplicate. */
    if(tos_shadow){
        unsigned lo=tos_mode_is_colour()?0u:(unsigned)r->x/8u;
        unsigned hi=tos_mode_is_colour()?stride:(unsigned)(r->x+r->w)/8u;
        /* Word-wise when possible: byte-by-byte over a full screen was 32 000
           loads+stores per frame. */
        if((lo%4u)==0u&&((hi-lo)%4u)==0u){
            unsigned w4=(hi-lo)/4u;
            for(y=(unsigned)r->y;y<(unsigned)(r->y+r->h);y++){
                const uint32_t *s4=(const uint32_t *)(const void *)(tos_screen+y*stride+lo);
                uint32_t *d4=(uint32_t *)(void *)(tos_shadow+y*stride+lo);
                for(x=0u;x<w4;x++)d4[x]=s4[x];
            }
        }else{
            for(y=(unsigned)r->y;y<(unsigned)(r->y+r->h);y++)
                for(x=lo;x<hi;x++)tos_shadow[y*stride+x]=tos_screen[y*stride+x];
        }
    }
    if(tos_client_surface)kernel_wm_app_dirty(tos_client_surface,r->x,r->y,r->x+r->w,r->y+r->h);
    kdbg_perf_dirty_rows+=(uint32_t)r->h;
    ++kdbg_perf_presents; /* rectangles, not FPS; frames has its own counter */
}

static void tos_present_finish(void)
{
    if(tos_client_surface)kernel_wm_compose_now();
    else kvideo_flush();
    ++kdbg_perf_frames;
}

static void tos_composite_now(void)
{
    tos_damage_rect_t r;
    if(!tos_screen)return;
    if(tos_mode_is_colour()? !vid_blit_planar:!vid_blit_mono)return;
    tos_present_reset();
    r.x=r.y=0;r.w=tos_src_width();r.h=tos_src_height();
    tos_convert_rect(&r);
    tos_band_valid=1u;
    tos_last_content_tick=tos_now_ticks();
    tos_present_finish();
}
static void tos_draw_console_window(void);

/* Mouse events for the TOS window.  INPUT.SYS owns the raw IKBD stream and
   decodes packets into the kernel's mouse queue; on the desktop ksessions_pump()
   drains that queue, but a TOS program runs SYNCHRONOUSLY and blocks the main
   loop, so nothing consumed it: the pointer stood still and the packet was
   applied only after the program exited (the reported "cursor jumps when the
   program closes").  While a TOS program is active this is the single consumer,
   exactly as the audit recommended.  Position and button state only - no
   desktop action is run from here, and no keyboard stream is touched. */
/* Window handles of the TOS personality live above the application range
   so a close request can be attributed to the running program. */
void tos_poll_mouse(void)
{
    if(!tos_active||tos_input_busy)return;
    tos_input_busy=1u;tos_poll_mouse_owned();tos_input_busy=0u;
}
static void tos_poll_mouse_owned(void)
{
    uint32_t buttons;int32_t dx,dy;int guard;
    if(!tos_active)return;          /* one consumer at a time */
    /* The window went away (closed from its own chrome or by the desktop):
       ask the run to unwind at the next OS call instead of blitting into a
       surface the compositor released. */
    if(tos_surface_installed&&!tos_client_surface)tos_exit_request=1u;
    for(guard=0;guard<64;++guard){
        if(tos_async_state){
            unsigned q;
            if(tos_async_mouse_head==tos_async_mouse_tail)break;
            q=tos_async_mouse_head++%TOS_ASYNC_EVENTS;
            buttons=tos_async_mice[q].buttons;
            dx=tos_async_mice[q].x-tos_async_mouse_x;dy=tos_async_mice[q].y-tos_async_mouse_y;
            tos_async_mouse_x=tos_async_mice[q].x;tos_async_mouse_y=tos_async_mice[q].y;
        }else if(!kernel_raw_mouse_event(&buttons,&dx,&dy))break;
        ++kdbg_tos_mouse_packets;
        kdbg_tos_mouse_dxdy=((uint32_t)(uint16_t)dx<<16)|(uint16_t)dy;
        if(!tos_async_state)ksessions_pointer_track(dx,dy);
        if(dx||dy||((buttons^tos_mouse_buttons)&3u))tos_wm_input_pending=1u;
        /* The blocking compatibility path handles chrome here. In cooperative
           mode the native input loop has already delivered these edges to WM. */
        if(!tos_async_state&&(buttons&3u)!=(tos_mouse_buttons&3u))
            ksessions_pointer_button(buttons,ksessions_mouse_x(),ksessions_mouse_y());
        tos_mouse_buttons=buttons;                  /* for evnt_mouse/graf_mouse */
        /* Deliver the packet to the program's mousevec, the way TOS does it:
           supervisor context, IKBD packet in d0 (buttons<<16 | dx<<8 | dy).
           We do NOT add a second IKBD reader - this is the same single owner
           that feeds evnt_mouse, so packet framing stays intact. */
        if(tos_kbdvecs&&tos_kbdvecs->mousevec){
            /* IKBD packet: header 0xF8|buttons, then signed dx and dy.  Large
               deltas are clamped to one byte each (the emulated mouse delivers
               small steps, and a wrapped value would move the pointer the wrong
               way); the audit asked for this to be explicit rather than a cast. */
            static uint8_t mouse_pkt[3];
            int32_t cdx=dx,cdy=dy;
            if(cdx>127)cdx=127;
            if(cdx<-128)cdx=-128;
            if(cdy>127)cdy=127;
            if(cdy<-128)cdy=-128;
            mouse_pkt[0]=(uint8_t)(0xf8u|(buttons&3u));
            mouse_pkt[1]=(uint8_t)(int8_t)cdx;
            mouse_pkt[2]=(uint8_t)(int8_t)cdy;
            asf_tos_call_mousevec(tos_kbdvecs->mousevec,mouse_pkt);
        }
    }
}
/* Called from the 50 Hz Timer C interrupt.  This must stay CHEAP: it only
 * drains the raw input ring and flags the window for a deferred composite.
 * The actual planar conversion runs in tos_composite_work() from the kernel
 * main loop, because a full 320x200/640x200 blit in the interrupt handler
 * froze the machine (that is the "1:1 client froze" failure mode). */
void tos_composite_tick(void)
{
    /* The 200 Hz clock has to advance while the guest COMPUTES, not only when
       it calls a service: SysInfo's CPU benchmark runs a delay loop through
       XBIOS Supexec and divides by the _hz_200 delta, so a counter updated only
       on service calls stayed flat and the division faulted.  Timer C keeps
       running during a TOS run, so this is the real source. */
    tos_clock_tick();
    /* Never poll while the program (IPL 5) is inside tos_poll_input(): the two
       would corrupt the shared mouse framing state. */
    if(tos_active&&!tos_input_busy)tos_poll_input();
    if(tos_window_active&&tos_screen)tos_composite_pending=1u;
}

/* Trap calls only wake the worker; they never advance its deadline. */
void tos_mark_present(void)
{
    if(tos_window_active&&tos_screen)tos_composite_pending=1u;
}

void tos_composite_work(void)
{
    uint32_t now;int input=0,changed=0;
    tos_damage_rect_t r;
    if(tos_async_state&&!tos_async_in_guest)return;
    tos_async_yield();
    if(tos_desktop_repaint&&!tos_client_surface){
        tos_desktop_repaint=0u;kernel_wm_compose_now();return;
    }
    if(!tos_composite_pending)return;
    tos_composite_pending=0u;
    if(!tos_window_active||!tos_screen)return;
    if(tos_mode_is_colour()? !vid_blit_planar:!vid_blit_mono)return;
    now=tos_now_ticks();
    /* Mouse/buttons are serviced at 50 Hz, independently of content (25 Hz).
       Do not consume their flags before the deadline. Timer C never renders. */
    if(tos_present_due(now,tos_last_cursor_tick,1u)){
        extern int ksessions_pointer_take_dirty(void);
        uint16_t saved_sr;
        __asm__ volatile("move.w %%sr,%0; ori.w #0x0700,%%sr":"=d"(saved_sr)::"memory");
        input=ksessions_pointer_take_dirty()||tos_wm_input_pending;
        tos_wm_input_pending=0u;
        __asm__ volatile("move.w %0,%%sr"::"d"(saved_sr):"memory");
        tos_last_cursor_tick=now;
    }
    if(tos_desktop_pending||tos_shadow_source!=tos_screen||
       tos_shadow_stride!=tos_src_stride()){
        tos_desktop_pending=0u;tos_present_reset();
    }
    if(!tos_band_valid||tos_force_present||tos_present_due(now,tos_last_content_tick,2u)){
        tos_force_present=0u;tos_last_content_tick=now;
        if(!tos_band_valid||!tos_shadow){
            /* Allocation failure is correct but slower: repaint on the same
               bounded deadline, never silently miss direct screen writes. */
            tos_damage_note(&tos_damage,0,0,tos_src_width(),tos_src_height());
        }else{
            tos_damage_scan(&tos_damage,tos_screen,tos_shadow,tos_src_stride(),!tos_mode_is_colour());
            kdbg_perf_scan_bytes+=(uint32_t)tos_src_stride()*tos_src_height();
            ++kdbg_perf_scan_calls;
        }
        /* Merge by cost, not by habit.  A single bounding box is right for
           dense damage (one menu repaint: hundreds of row spans), but two small
           changes far apart made it convert almost the whole screen.  Collect a
           bounded list instead: convert the rectangles separately while their
           extra area stays below what one extra call costs, and fall back to the
           union when the list is full or the box is not much larger than the
           real damage. */
        {tos_damage_rect_t list[TOS_PRESENT_RECTS];int n=0,over=0;
         long area=0;
         long bx0=0,by0=0,bx1=0,by1=0;
         while(tos_damage_take(&tos_damage,&r)){
             area+=(long)r.w*(long)r.h;
             if(!n){bx0=r.x;by0=r.y;bx1=(long)r.x+r.w;by1=(long)r.y+r.h;}
             else{
                 if(r.x<bx0)bx0=r.x;
                 if(r.y<by0)by0=r.y;
                 if((long)r.x+r.w>bx1)bx1=(long)r.x+r.w;
                 if((long)r.y+r.h>by1)by1=(long)r.y+r.h;
             }
             if(n<TOS_PRESENT_RECTS)list[n++]=r;
             else over=1;
         }
         if(n){
             long box=(bx1-bx0)*(by1-by0);
             if(over||n>TOS_PRESENT_RECTS||box<=area+TOS_PRESENT_MERGE_SLACK){
                 tos_damage_rect_t u;
                 u.x=(int)bx0;u.y=(int)by0;u.w=(int)(bx1-bx0);u.h=(int)(by1-by0);
                 tos_convert_rect(&u);
                 ++kdbg_perf_present_union;
             }else{
                 int k;
                 for(k=0;k<n;k++)tos_convert_rect(&list[k]);
                 kdbg_perf_present_split+=(uint32_t)n;
             }
             changed=1;
         }}
        tos_band_valid=1u;
    }
    if(changed||input){
        if(input&&!changed)++kdbg_perf_cursor_only;
        tos_present_finish();
    }
}

/* A program may call Setrez/Setscreen while its window is already open; the
   client geometry and the cached band signatures must follow. */
static void tos_msg_redraw(void)
{
    tos_redraw_msg[0]=20;                      /* WM_REDRAW */
    tos_redraw_msg[1]=0;tos_redraw_msg[2]=0;tos_redraw_msg[3]=1;
    tos_redraw_msg[4]=(int16_t)(tos_win_x?0:0);
    tos_redraw_msg[5]=0;
    tos_redraw_msg[6]=(int16_t)tos_win_w;
    tos_redraw_msg[7]=(int16_t)tos_win_h;
    tos_msg_post(tos_redraw_msg);
}

void tos_window_geometry_changed(void)
{
    tos_update_window_geometry();
    tos_vdi_follow_screen();          /* new screen/stride after Setscreen */
    /* Centre on the REAL screen: the old 800x600 constants clipped the window
       on a 640x400 desktop and left it off-centre on 1024x768. */
    tos_win_x=((int32_t)kvideo_mode_width()-(int32_t)tos_win_w)/2;
    tos_win_y=((int32_t)kvideo_mode_height()-(int32_t)tos_win_h-(int32_t)TOS_TITLE)/2;
    if(tos_win_x<8)tos_win_x=8;
    if(tos_win_y<8)tos_win_y=8;
    if(tos_wm_pid)kernel_wm_resize_window(tos_wm_pid,tos_wm_handle,
        (int16_t)tos_win_x,(int16_t)tos_win_y,(uint16_t)tos_win_w,(uint16_t)(tos_win_h+TOS_TITLE));
    tos_band_valid=0u;
    tos_present_reset();
}

