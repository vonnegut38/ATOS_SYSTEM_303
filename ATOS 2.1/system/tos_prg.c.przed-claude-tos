{
    __asm__ volatile("move.w %1,%0@" : : "a"((void *)(uintptr_t)address),"d"(value>>16) : "memory");
    __asm__ volatile("move.w %1,%0@" : : "a"((void *)(uintptr_t)(address+2u)),"d"(value&0xffffu) : "memory");
