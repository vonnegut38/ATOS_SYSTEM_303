    if(!kernel_user_keyboard_event(&t,&s,&m,&c))return 0;
    /* AWARYJNE ZAKONCZENIE PROGRAMU TOS: Ctrl+Alt+Esc.  Sprawdzane PRZED
       zakolejkowaniem do goscia, wiec zadziala takze wtedy, gdy program TOS
       jest niereagujacy i nie da sie go zamknac.  Bez tego jeden taki program
       trzymal klawiature (kernel_tos_async_owns) i slot procesu, a jedynym
       wyjsciem byl restart maszyny.  Klawisz jest konsumowany (nie idzie do
       goscia). */
