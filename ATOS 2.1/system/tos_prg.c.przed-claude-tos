    void *midivec;                     /* +0x00 */
    void *vkbderr;                     /* +0x04 */
    void *vmousevec;                   /* +0x08 */
    void *reserved0;                   /* +0x0C */
    void *mousevec;                    /* +0x10  <- programs save/install this */
} tos_kbdvecs_t;
